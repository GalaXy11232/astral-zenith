---
import Icon from "./Icon.astro";

export interface Props {
  label: string;
  value: string;
  href: string;
  icon: "email" | "instagram" | "tiktok" | "linkedin" | "website" | string;
  external?: boolean;
}

const { label, value, href, icon, external = true } = Astro.props;
---

<a
  class="contact-card glass glass-hover"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="glass-sheen" aria-hidden="true"></span>
  <span class="contact-card__icon">
    <Icon name={icon} size={24} />
  </span>
  <span class="contact-card__text">
    <span class="contact-card__label">{label}</span>
    <span class="contact-card__value">{value}</span>
  </span>
</a>

<style>
    /* sticla vine din .glass / .glass-hover (global.css) */
    .contact-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
        max-width: 230px;
        flex: 0 1 230px;
        padding: 1.35rem 1.4rem;
        border-radius: 1.1rem;
        text-decoration: none;
    }

    .contact-card__icon {
        flex: 0 0 auto;
        width: 3.1rem;
        height: 3.1rem;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        /* --glass-text-soft e brand-100 pe intuneric, adica exact valoarea
           de dinainte; pe tema deschisa se intoarce, altfel iconita
           lavanda dispare in cartonasul alb. */
        color: var(--glass-text-soft);
        background: var(--icon-bubble-bg);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        box-shadow: inset 0 0 0 1px var(--glass-hilite);
        transition: transform 0.35s ease;
    }

    .contact-card:hover .contact-card__icon {
        transform: rotate(-6deg) scale(1.06);
    }

    .contact-card__text {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .contact-card__label {
        font-family: "Space Grotesk", system-ui, sans-serif;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--glass-text-soft);
    }

    .contact-card__value {
        font-size: 1rem;
        font-weight: 600;
        color: var(--glass-text);
        overflow-wrap: anywhere;
    }
</style>
