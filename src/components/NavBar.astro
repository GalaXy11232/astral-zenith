---
/*
 * Doua sigle, comutate din CSS dupa data-theme. Sigla alba dispare complet
 * pe fundalul deschis cat timp bara e transparenta (adica pana la primul
 * scroll). Ambele se randeaza in HTML ca schimbarea sa nu depinda de JS.
 */
const home_button_src = {
    dark:  "/assets/Logo_alb.png",
    light: "/assets/Logo_mov.png",
};

// Colegiul National „Grigore Moisil” — acelasi link ca pe pagina de sponsori
const school = {
    logo: "/assets/parteneri/Sigla_CNGM.png",
    name: "Colegiul Național „Grigore Moisil”",
    website: "https://www.moisil.ro/"
};

// selected link prop
const { activeLink = -1, has_margin = true } = Astro.props;
/*
 * Etichetele au traducere scrisa de mana, iar linkurile sunt marcate
 * translate="no". Google traducea "Rezultate" la singular ("Result"), si oricum
 * nu avem niciun control asupra a ce scoate. Sunt opt cuvinte in cea mai
 * vizibila parte a site-ului — merita sa fie exacte si sa apara instant, fara
 * sa astepte procesarea Google.
 */
/*
 * ATENTIE: `activeLink` e un INDICE in lista de mai jos, dat de fiecare pagina.
 * Daca schimbi ordinea, actualizeaza si numerele din <NavBar activeLink={...}>
 * in src/pages/ — altfel se evidentiaza linkul gresit.
 */
const links = [
    { name: "Acasă",      en: "Home",     href: "/" },           // 0
    { name: "Rezultate",  en: "Results",  href: "/rezultate" },  // 1
    { name: "Activitate", en: "Activity", href: "/activitate" }, // 2
    { name: "Echipă",     en: "Team",     href: "/echipa" },     // 3
    { name: "Sponsori",   en: "Sponsors", href: "/sponsori" },   // 4
    { name: "Galerie",    en: "Gallery",  href: "/galerie" },    // 5
    { name: "Presă",      en: "Press",    href: "/news" },       // 6
    { name: "Contact",    en: "Contact",  href: "/contact" }     // 7
]
---
<div class = 'mobile-background-blur' onclick = 'switch_menu_visibility("0px")' />
<nav>
    <div class = 'home-container'>
        <a class = 'navbar-home scale-hover' href="/">
            <img class = "logo-dark"  style = "width: calc(var(--min-height) - 5px);" src = {home_button_src.dark}  alt="Home" />
            <img class = "logo-light" style = "width: calc(var(--min-height) - 5px);" src = {home_button_src.light} alt="Home" />
        </a>

        <a
            class = 'navbar-school scale-hover'
            href = {school.website}
            target = "_blank"
            rel = "noopener noreferrer"
            title = {school.name}
            aria-label = {school.name}
        >
            <img src = {school.logo} alt = {school.name} decoding = "async" />
        </a>
    </div>
    
    <div class = 'links-container'>
        <div class="gtranslate_wrapper"></div>

        <a class="hamburger-btn" onclick = 'switch_menu_visibility()' >&#8801;</a>
        <!-- genereaza dinamic linkurile -> se poate atribui din index activeLink prop -->
        <div class="links-wrapper">
            {
                links.map((link, index) => {
                    return (<>
                        <a
                            class = {`navbar-link scale-hover notranslate ${activeLink === index ? "active" : ""}`}
                            translate = "no"
                            data-ro = {link.name}
                            data-en = {link.en}
                            href = {link.href}
                        >
                            {link.name}
                        </a>

                    </>);
                })
            }
        </div>

        <!-- Comutator de tema. Arata pictograma temei in care INTRI daca il
             apesi, exact ca butonul de limba de dedesubt. -->
        <button
            type="button"
            class="theme-toggle notranslate"
            translate="no"
            aria-label="Comută pe tema deschisă"
            title="Comută pe tema deschisă"
        >
            <span class="theme-icon theme-icon--light" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
                </svg>
            </span>
            <span class="theme-icon theme-icon--dark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
                </svg>
            </span>
        </button>

        <!-- Un singur buton: arata steagul limbii in care INTRI daca il apesi.
             data-target e pus de script din cookie-ul googtrans.
             Sta ultimul in DOM ca sa fie lipit de marginea din dreapta a barei;
             pe mobil il trece inaintea hamburgerului o regula de `order`. -->
        <button
            type="button"
            class="lang-toggle notranslate"
            translate="no"
            data-target="en"
            aria-label="Switch to English"
            title="Switch to English"
        >
            <span class="lang-flag lang-flag--ro" aria-hidden="true">
                <svg viewBox="0 0 3 2" preserveAspectRatio="xMidYMid slice">
                    <rect x="0" width="1" height="2" fill="#002B7F"/>
                    <rect x="1" width="1" height="2" fill="#FCD116"/>
                    <rect x="2" width="1" height="2" fill="#CE1126"/>
                </svg>
            </span>
            <span class="lang-flag lang-flag--en" aria-hidden="true">
                <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice">
                    <clipPath id="uk-frame"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
                    <clipPath id="uk-diag"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath>
                    <g clip-path="url(#uk-frame)">
                        <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
                        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
                        <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-diag)" stroke="#C8102E" stroke-width="4"/>
                        <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
                        <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
                    </g>
                </svg>
            </span>
        </button>
    </div>
</nav>

<div class="mobile-nav">
    <div class="mobile-xbtn-container">
        <a class = 'mobile-xbtn' onclick = 'switch_menu_visibility()'>x</a>
    </div>
    <div style = "display: flex; justify-content: center; width: 100%; height: 100%;">
        <div class="mobile-links-wrapper">
            {
                links.map((link, index) => {
                    return (<a 
                        class = {`mobile-navbar-link scale-hover notranslate ${activeLink === index ? "mobile-active" : ""}`}
                        translate = "no"
                        data-ro = {link.name}
                        data-en = {link.en}
                        href = {link.href}
                    > 
                        {link.name} 
                    </a>);
                })
            }
        </div>
    </div>
</div>

{has_margin && <div class = 'nav-margin'></div>}

<script>
    function update_background() {
        const nav = document.querySelector("nav") as HTMLElement | null;
        if (!nav) return;

        const yOffset = window.pageYOffset || document.body.scrollTop;

        // clasa, nu stiluri inline: fundalul sta pe nav::before ca sa poata fi
        // estompat spre baza fara sa se estompeze si logourile sau linkurile
        nav.classList.toggle("is-scrolled", yOffset > 20);
    }
    
    // un singur listener de scroll pe toata durata sesiunii — altfel se acumuleaza
    // cate unul la fiecare navigare ClientRouter
    window.addEventListener("scroll", update_background);

    /** Limba activa, din cookie-ul pus de GTranslate. Implicit romana. */
    function current_language(): string {
        const match = document.cookie.match('(^|;) ?googtrans=([^;]*)(;|$)');
        return match?.[2]?.split('/')?.[2] || 'ro';
    }

    /** Pune pe fiecare link eticheta din limba activa. */
    function paint_nav_labels() {
        const language = current_language();

        document.querySelectorAll<HTMLElement>('[data-ro][data-en]').forEach(link => {
            const label = language === 'en' ? link.dataset.en : link.dataset.ro;
            if (label && link.textContent?.trim() !== label) link.textContent = label;
        });
    }

    function paint_lang_toggle(button: HTMLElement) {
        // butonul arata limba in care INTRI, nu pe cea activa
        const target = current_language() === 'ro' ? 'en' : 'ro';
        const label = target === 'en' ? 'Switch to English' : 'Comută în română';

        button.dataset.target = target;
        button.setAttribute('aria-label', label);
        button.title = label;
    }

    /** Eticheta butonului de tema, in limba activa si pentru tema tinta. */
    function paint_theme_toggle(button: HTMLElement) {
        const going_light = document.documentElement.dataset.theme !== 'light';
        const label = current_language() === 'en'
            ? (going_light ? 'Switch to light theme' : 'Switch to dark theme')
            : (going_light ? 'Comută pe tema deschisă' : 'Comută pe tema închisă');

        button.setAttribute('aria-label', label);
        button.title = label;
    }

    function init_theme_toggle() {
        const button = document.querySelector('.theme-toggle') as HTMLElement | null;
        if (!button) return;

        paint_theme_toggle(button);

        // acelasi paznic ca la butonul de limba: ClientRouter ruleaza
        // init-ul la fiecare navigare, iar butonul supravietuieste swapului
        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";

        button.addEventListener('click', () => {
            const root = document.documentElement;
            const light = root.dataset.theme !== 'light';

            if (light) root.dataset.theme = 'light';
            else root.removeAttribute('data-theme');

            try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch (e) {}

            paint_theme_toggle(button);

            /*
             * Fundalul cu hexagoane e WebGL: nu se recalculeaza singur cand
             * se schimba tokenii CSS. hexbackground.astro asculta exact
             * evenimentul asta si isi repicteaza scena existenta.
             */
            window.dispatchEvent(new Event('theme-change'));
        });
    }

    /*
     * flags.js incarca motorul Google (translate_a/element.js) abia cand cineva
     * atinge widgetul GTranslate — pointerenter/focusin pe .gtranslate_wrapper —
     * sau cand cookie-ul googtrans arata deja alta limba. Dar noi ascundem
     * widgetul (navbar.css: pointer-events:none) si punem .lang-toggle in locul
     * lui, deci pentru un vizitator fara cookie nimic nu declanseaza incarcarea:
     * doGTranslate exista, insa nu gaseste <select.goog-te-combo> si se
     * reprogrameaza la infinit din 500 in 500 ms. Pe calculatorul de dezvoltare
     * bugul nu se vede, fiindca acolo cookie-ul googtrans a ramas de la testele
     * anterioare si atunci flags.js incarca motorul singur.
     *
     * Il cerem noi, exact ca load_tlib din flags.js si prin acelasi
     * window.gt_translate_script, ca widgetul sa nu il mai ceara a doua oara.
     */
    function load_translate_engine() {
        const w = window as any;

        // fara flags.js nu exista callbackul pe care il apeleaza scriptul Google
        if (w.gt_translate_script || typeof w.googleTranslateElementInit2 !== 'function') return;

        const script = document.createElement('script');
        script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit2';
        w.gt_translate_script = script;
        document.body.appendChild(script);
    }

    /**
     * Ruleaza `done` cand cookie-ul googtrans ajunge la `language`. La primul
     * clic motorul Google abia se descarca, deci raspunsul poate intarzia mult
     * peste cele cateva zeci de ms in care se face o comutare ulterioara.
     */
    function when_language_applied(language: string, done: () => void) {
        const deadline = Date.now() + 8000;

        (function poll() {
            if (current_language() === language || Date.now() > deadline) done();
            else window.setTimeout(poll, 100);
        })();
    }

    function init_lang_toggle() {
        const button = document.querySelector('.lang-toggle') as HTMLElement | null;
        if (!button) return;

        paint_lang_toggle(button);

        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";

        // pornim descarcarea din timp, ca primul clic sa nu astepte dupa ea
        button.addEventListener('pointerenter', load_translate_engine);
        button.addEventListener('focus', load_translate_engine);

        button.addEventListener('click', () => {
            const translate = (window as any).doGTranslate;
            if (typeof translate !== 'function') return;

            load_translate_engine();

            // GTranslate asteapta mereu "limba_originala|limba_tinta";
            // ro|ro readuce pagina la textul original
            const from = (window as any).gtranslateSettings?.default_language || 'ro';
            const target = button.dataset.target || 'en';
            translate(`${from}|${target}`);

            // cookie-ul se scrie de GTranslate, deci recitim dupa ce termina
            when_language_applied(target, () => {
                paint_lang_toggle(button);
                paint_nav_labels();

                const theme_button = document.querySelector('.theme-toggle') as HTMLElement | null;
                if (theme_button) paint_theme_toggle(theme_button);
            });
        });
    }

    ['astro:page-load', 'DOMContentLoaded'].forEach((ev) => {
        document.addEventListener(ev, update_background);
        document.addEventListener(ev, init_lang_toggle);
        document.addEventListener(ev, init_theme_toggle);
        document.addEventListener(ev, paint_nav_labels);
    });
</script>

<script is:inline>
    function switch_menu_visibility(force_value = null) {
        let mobilenav = document.querySelector('.mobile-nav');
        let bgblur = document.querySelector('.mobile-background-blur');
        let wd = mobilenav.style.width;

        if (force_value) {
            mobilenav.style.width = force_value;
            bgblur.style.opacity = force_value == '0px' ? '0' : '1';
        }
        else {
            mobilenav.style.width = wd == '0px' ? '100%' : '0px';
            bgblur.style.opacity = wd == '0px' ? '1' : '0';
        }
    }

    function onload_menu_setup() {
        let mobilenav = document.querySelector('.mobile-nav');
        let bgblur = document.querySelector('.mobile-background-blur');
        
        mobilenav.style.width = '0px'; 
        bgblur.style.opacity = '0';
        bgblur.addEventListener('transitionend', () => {
            bgblur.style.pointerEvents = bgblur.style.opacity == '0' ? 'none' : 'all';
        });
    }

    document.addEventListener('astro:page-load', onload_menu_setup);
</script>

<!-- navbar.css -->