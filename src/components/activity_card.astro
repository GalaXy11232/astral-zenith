---
const {
    title,
    date,
    thumbnail,
    thumbnailAlt    = title,
    thumbnailHeight = '280px',
    thumbnailFocus  = 'center',
    previewLines    = 3,
    readMoreLabel   = 'Citește mai mult…',
    readLessLabel   = 'Citește mai puțin…',
    uid: uidProp,
} = Astro.props;

// Each instance gets a unique ID so multiple cards on the same page
// don't share toggle state.
//
// Cand pagina are un slug stabil (folderul activitatii), il folosim pe el:
// id-ul ajunge in HTML, deci cu Math.random() ancora se schimba la fiecare
// build si un link catre /activitate#... nu mai nimereste acelasi card.
const uid = uidProp ?? `activity-${Math.random().toString(36).slice(2, 8)}`;
---

<div style = "margin: 5rem 3rem;">
    <article class="activity-card glass">
        <span class="glass-sheen" aria-hidden="true"></span>
        {/* Fara conditia asta, o activitate fara coperta randa <img src="">,
            adica o zona goala de 280px cu iconita de imagine stricata. Erau
            17 carduri in situatia asta. Acum cardul incepe direct cu textul. */}
        {thumbnail && (
            <div class="thumbnail-wrap" style={`--thumb-h: ${thumbnailHeight};`}>
                <img
                    src={thumbnail}
                    alt={thumbnailAlt}
                    class="thumbnail-img"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    style={`object-position: ${thumbnailFocus};`}
                />
            </div>
        )}


        <div class="card-body">

            <div class="card-meta">
                <span class="card-date">{date}</span>
            </div>

            <h2 class="card-title">{title}</h2>

            <!--
                The slot content is the article body (paragraphs).
                We wrap it in a clamp container whose max-height is driven
                by a CSS custom property set from the previewLines prop.
                A data attribute carries the two label strings so the
                script below can swap them without any framework JS.
            -->
            <div
                class="card-content"
                id={uid}
                style={`--preview-lines: ${previewLines};`}
                data-read-more={readMoreLabel}
                data-read-less={readLessLabel}
                data-expanded="false"
            >
                <div class="card-content-inner">
                    <slot />
                </div>
            </div>

            <button
                class="toggle-btn"
                aria-controls={uid}
                aria-expanded="false"
            >
                {readMoreLabel}
            </button>

        </div>
    </article>
</div>

<style>
    /* sticla vine din .glass (global.css) */
    .activity-card {
        border-radius: 18px;
        overflow:      hidden;
        max-width:     760px;
        width:         100%;
        margin:        0 auto;
    }

    /* fara backdrop-filter aici: poza acopera integral zona, deci blur-ul din
       spate nu s-ar vedea niciodata — dar s-ar plati pe fiecare din cele ~70
       de carduri ale paginii */
    .thumbnail-wrap {
        width:     100%;
        height:    var(--thumb-h, 280px);
        overflow:  hidden;
        border-radius: 18px 18px 0 0;
        border-bottom: 1px solid var(--glass-border);
        background: var(--glass-fill);
        flex-shrink: 0;
        display:   flex;
        align-items: center;
        justify-content: center;
    }

    .thumbnail-img {
        width:      100%;
        height:     100%;
        object-fit: cover;
        display:    block;
        animation:       thumb-in 0.4s ease both;
    }

    @keyframes thumb-in {
        from { opacity: 0; transform: scale(1.02); }
        to   { opacity: 1; transform: scale(1);    }
    }

    .card-body {
        padding: 1.5rem 1.75rem 1.75rem;
    }

    .card-meta {
        margin-bottom: 0.25rem;
    }
    .card-date {
        font-size:      0.8rem;
        font-weight:    400;
        color:          var(--glass-text-dim);
        letter-spacing: 0.01em;
    }

    .card-title {
        font-size:     1.15rem;
        font-weight:   700;
        color:         var(--glass-text);
        margin:        0 0 1rem;
        line-height:   1.3;
    }

    /* ── Expandable content block ───────────────────────────────────────── */
    /*
     * The clamp is done via max-height:
     *   line-height (1.55) × font-size (1.07rem = ~17.1px) × N lines
     *   = ~26.5px × N
     * Atentie: `em` de mai jos se rezolva fata de .card-content, care
     * ramane la 1rem — nu fata de 1.07rem al paragrafului. De aceea
     * factorul e 1.55 × 1.07 = ~1.66em, nu 1.55em. Daca se schimba
     * font-size sau line-height la paragraf, se schimba si aici, altfel
     * previzualizarea taie alt numar de randuri decat --preview-lines.
     * We add a small extra to not cut a line exactly in half.
     *
     * When expanded, max-height is set to a large safe value in JS.
     * Using `overflow: hidden` + `max-height` transition gives a smooth
     * accordion without needing to know the real content height.
     */
    .card-content {
        /* Justify fara hyphens: auto lasa "rauri" de spatiu alb intre
           cuvinte — mai vizibil cu cuvinte lungi romanesti. Stanga simpla
           se citeste mai usor si e deja precedentul din result_card.astro. */
        text-align: left;
        overflow:   hidden;
        max-height: calc(1.66em * var(--preview-lines, 3) + 0.4em);
        transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1);
        -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
                mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    }

    .card-content[data-expanded="true"] {
        -webkit-mask-image: none;
                mask-image: none;
    }


    .card-content-inner :global(p) {
        /* Peste 16px, minimul pentru text de tip paragraf — sub acel prag
           Safari mai si da zoom automat pe mobil la focus, iar litera
           devine grea de citit pe ~70 de carduri de pe pagina asta. */
        font-size:     1.07rem;
        line-height:   1.55;
        color:         var(--glass-text-soft);
        margin:        0 0 0.85rem;
        text-indent:   1.2em;  /* matches the screenshot's paragraph indent */
    }
    .card-content-inner :global(p:last-child) {
        margin-bottom: 0;
    }

    .toggle-btn {
        display:        inline-block;
        margin-top:     0.9rem;
        background:     none;
        border:         none;
        padding:        0;
        font-size:      0.9rem;
        font-weight:    500;
        color:          var(--accent-text);
        cursor:         pointer;
        letter-spacing: 0.01em;
        transition:     opacity 0.2s;
        font-family:    inherit;
    }
    .toggle-btn:hover {
        opacity: 0.7;
    }
    .toggle-btn:focus-visible {
        outline:        2px solid var(--brand-300);
        outline-offset: 3px;
        border-radius:  3px;
    }

    @media (max-width: 520px) {
        .card-body {
            padding: 1.1rem 1.1rem 1.4rem;
        }
        .card-title {
            font-size: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .card-content { transition: none !important; }
        .thumbnail-img { animation: none !important; }
    }
</style>

<script>
    function initActivityCards() {
        document.querySelectorAll<HTMLElement>('.card-content').forEach(content => {
            const btn = content.parentElement?.querySelector<HTMLButtonElement>('.toggle-btn');
            if (!btn || (content as any)._acInit) return;
            (content as any)._acInit = true;

            const labelMore = content.dataset.readMore ?? 'Citește mai mult…';
            const labelLess = content.dataset.readLess ?? 'Citește mai puțin…';

            btn.addEventListener('click', () => {
                const expanded = content.dataset.expanded === 'true';

                if (!expanded) {
                    const inner = content.querySelector<HTMLElement>('.card-content-inner');
                    const fullH = inner ? inner.scrollHeight : 9999;

                    content.style.maxHeight  = fullH + 'px';
                    content.dataset.expanded = 'true';
                    btn.textContent          = labelLess;
                    btn.setAttribute('aria-expanded', 'true');
                } else {
                    content.style.maxHeight  = '';
                    content.dataset.expanded = 'false';
                    btn.textContent          = labelMore;
                    btn.setAttribute('aria-expanded', 'false');
                }
            });
        });
    }

    document.addEventListener('astro:page-load', initActivityCards);
</script>