---
// HexBackground.astro
// Places the viewer inside a cylinder made of hexagon rings.
// Odd rings rotate clockwise, even rings counter-clockwise.
// Rings move infinitely up or down, wrapping seamlessly.
---
<canvas id="hex-bg-canvas"></canvas>

<style>
    #hex-bg-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        display: block;
        pointer-events: none;
    }
</style>

<script>
/** Citeste un token CSS, cu valoare de rezerva daca lipseste. */
function token(name: string, fallback: string): string {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return value || fallback;
}

/**
 * Culorile fundalului vin din tokenii de tema, nu sunt scrise aici: e WebGL,
 * deci nu se schimba singur cand se schimba tema — se reconstruieste la
 * evenimentul 'theme-change' trimis de butonul din header.
 */
function themeColors() {
    const bg = token('--page-bg', '#0b0714');
    const palette = token('--hex-palette', '#120436, #180647, #1e0759, #1e0759, #24086b, #2a0a7c')
        .split(',')
        .map(c => c.trim())
        .filter(Boolean);

    return {
        background: bg,
        fog: token('--hex-fog', bg),
        palette,
        opacity: parseFloat(token('--hex-opacity', '0.4')) || 0.4,
        ambient: parseFloat(token('--hex-ambient', '0.35')) || 0.35,
        // Si luminile sunt tokeni: erau scrise aici si ramaneau violete
        // dupa comutare, spaland orice paleta mai deschisa.
        directional: [
            token('--hex-dir-1', '#8c55f7'),
            token('--hex-dir-2', '#7c46e5'),
        ],
        /*
         * Intensitatile trebuie sa fie tot per-tema, nu fixe in CONFIG.
         * Luminile se ADUNA peste albedo: cu ambient 0.95 + 1.4 + 0.6
         * totalul trecea de 2.9, deci canalele se saturau la alb si
         * culoarea se pierdea. Pe fundal inchis nu se vedea (albedo
         * intunecat, ramanea loc pana la clipping), dar pe tema deschisa
         * albedo-ul e luminos si rezultatul iesea spalat — exact "gri".
         * Bugetul de lumina (ambient + directionale) trebuie sa stea in
         * jur de 1.0 ca sa se pastreze nuanta.
         */
        directionalIntensity: [
            parseFloat(token('--hex-dir-1-intensity', '1.4')) || 1.4,
            parseFloat(token('--hex-dir-2-intensity', '0.6')) || 0.6,
        ],
    };
}

const CONFIG = {
    // Ceata: doar distantele sunt fixe, culoarea vine din --hex-fog.
    fog: { near: 8, far: 40 },

    camera: {
        fov:      75,
        near:     0.1,
        far:      100,
        position: [0, 0, 0] as [number, number, number],
    },

    cylinder: {
        radius:      9,
        hexPerRing:  12,
        rings:       14,
        ringSpacing: 2.2,
        yOffset:    -4,
    },

    shape: {
        radius:    0.85,
        thickness: 0.12,
    },

    colors: {
        flatShading: true,
    },

    /* Culorile vin din tokeni (theme.ambient / theme.directional); aici
       raman doar geometria si intensitatile, care nu tin de tema. */
    lights: {
        ambient:     { color: 0xffffff },
        // doar pozitiile raman fixe; culoarea si intensitatea vin din tokeni
        directional: [
            { position: [0,  8,  2] as [number,number,number] },
            { position: [0, -6, -2] as [number,number,number] },
        ],
    },

    motion: {
        // Rotatia inelelor: cerut mai lenta decat 0.001, care citea ca o
        // invartire vizibila in loc de o miscare de fundal.
        ringSpeed:         0.0004,
        parallax:          0.18,
        parallaxEase:      0.03,
        verticalSpeed:     0.002, // How fast the rings move up/down
        verticalDirection: -1,    // 1 for UP, -1 for DOWN
    },
};

/*
 * Pe telefon scena asta costa mult mai mult decat arata: 14 inele x 12
 * hexagoane inseamna 168 de desenari pe cadru, cu antialiasing, la doua ori
 * densitatea ecranului — pe un ecran de 3x asta e de patru ori mai multi
 * fragmenti decat are nevoie. Reducem numarul de forme si desenam la 1x;
 * cilindrul arata la fel, fiindca oricum se pierde in ceata dupa cateva inele.
 *
 * Functie, nu constanta: ClientRouter tine modulul incarcat intre pagini, deci
 * o valoare calculata o singura data ar ramane blocata pe latimea de la prima
 * incarcare (ex. rotirea telefonului, sau fereastra redimensionata pe desktop).
 */
const isPhone = () => window.matchMedia('(max-width: 700px)').matches;

/* Ecran tactil: nu exista cursor dupa care sa se miste paralaxa, deci nici
   ascultatorul de mousemove n-are ce cauta acolo. */
const isCoarsePointer = () => window.matchMedia('(pointer: coarse)').matches;

const MOBILE_CYLINDER = { rings: 8, hexPerRing: 8 };

const pick = <T>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)];

async function initBackground() {
    const canvas = document.getElementById('hex-bg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    if ((canvas as any)._initialized) return;
    (canvas as any)._initialized = true;

    let THREE: any;
    try {
        THREE = await import('three');
    } catch {
        console.warn('[HexBG] three not found — run: npm i three');
        return;
    }

    const theme = themeColors();

    // Renderer
    const phone = isPhone();
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: !phone, alpha: false });
    renderer.setPixelRatio(phone ? 1 : Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    // Scene
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(theme.background);
    scene.fog = new THREE.Fog(theme.fog, CONFIG.fog.near, CONFIG.fog.far);

    // Camera
    const camera = new THREE.PerspectiveCamera(
        CONFIG.camera.fov,
        window.innerWidth / window.innerHeight,
        CONFIG.camera.near,
        CONFIG.camera.far,
    );
    camera.position.set(...CONFIG.camera.position);

    // Lights
    const ambient = new THREE.AmbientLight(CONFIG.lights.ambient.color, theme.ambient);
    scene.add(ambient);

    // Tinute intr-un array: onThemeChange trebuie sa le poata repicta.
    const directionals = CONFIG.lights.directional.map((dl, i) => {
        const l = new THREE.DirectionalLight(theme.directional[i], theme.directionalIntensity[i]);
        l.position.set(...dl.position);
        scene.add(l);
        return l;
    });

    // Shared hexagon geometry
    const hexGeo = new THREE.CylinderGeometry(
        CONFIG.shape.radius,
        CONFIG.shape.radius,
        CONFIG.shape.thickness,
        6, 1, false,
    );
    hexGeo.rotateX(Math.PI / 2);

    // Build rings
    const { radius, ringSpacing, yOffset } = CONFIG.cylinder;
    const { rings, hexPerRing } = phone ? MOBILE_CYLINDER : CONFIG.cylinder;
    const ringGroups: any[] = [];

    for (let r = 0; r < rings; r++) {
        const group = new THREE.Group();
        group.position.y = yOffset + (r - (rings - 1) / 2) * ringSpacing;

        for (let h = 0; h < hexPerRing; h++) {
            const angle = (h / hexPerRing) * Math.PI * 2;

            const mat = new THREE.MeshStandardMaterial({
                color:       pick(theme.palette),
                opacity:     theme.opacity,
                transparent: theme.opacity < 1,
                flatShading: CONFIG.colors.flatShading,
            });

            const mesh = new THREE.Mesh(hexGeo, mat);

            // Place on cylinder surface
            mesh.position.x = Math.sin(angle) * radius;
            mesh.position.z = Math.cos(angle) * radius;

            // Face the hexagon inward toward the viewer at the origin
            mesh.rotation.y = angle + Math.PI;

            group.add(mesh);
        }

        scene.add(group);
        ringGroups.push(group);
    }

    // Mathematical boundaries for the infinite loop
    const totalHeight = rings * ringSpacing;
    const halfHeight = totalHeight / 2;

    // Mouse parallax state
    let targetRotX = 0, targetRotY = 0;
    let currentRotX = 0, currentRotY = 0;

    const onMouse = (e: MouseEvent) => {
        targetRotY =  (e.clientX / window.innerWidth  - 0.5) * 2 * CONFIG.motion.parallax;
        targetRotX = -(e.clientY / window.innerHeight - 0.5) * 2 * CONFIG.motion.parallax;
    };
    const wantsParallax = !isCoarsePointer();
    if (wantsParallax) window.addEventListener('mousemove', onMouse);

    const onResize = () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    };
    window.addEventListener('resize', onResize);

    /*
     * setSize() de mai sus, la initializare, ruleaza chiar dupa
     * `await import('three')` — adica in prima bucla de microtask-uri de
     * dupa navigare, inainte ca layout-ul sa fie neaparat asezat definitiv
     * (webfont-uri incarcate async, alte scripturi din <head>). Cand se
     * intampla asta, canvas-ul ramane la dimensiunea implicita 300x150 si
     * fundalul e practic invizibil pana la primul resize real al
     * ferestrei. Un rAF garanteaza un layout deja asezat, deci repeta
     * calculul o data in siguranta, fara sa strice nimic daca nu era
     * nevoie. */
    requestAnimationFrame(onResize);

    let rafId: number;

    /* Fundalul asta ruleaza o bucla rAF infinita, cu hexagoane care se rotesc
       si urca, pe 6 din cele 8 pagini. Era singurul element puternic animat de
       pe site fara nicio verificare de reduced-motion (WCAG 2.2.2). Cu
       preferinta activa desenam O SINGURA data — geometria ramane pe ecran,
       dar nemiscata — in loc sa oprim tot si sa lasam pagina goala. */
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const animate = () => {
        if (reduceMotion.matches) {
            renderer.render(scene, camera);
            return;
        }
        rafId = requestAnimationFrame(animate);

        // Apply animations to each ring
        for (let r = 0; r < ringGroups.length; r++) {
            const group = ringGroups[r];
            
            // 1. Alternate ring rotation direction
            group.rotation.y += CONFIG.motion.ringSpeed * (r % 2 === 0 ? 1 : -1);

            // 2. Vertical continuous movement
            group.position.y += CONFIG.motion.verticalSpeed * CONFIG.motion.verticalDirection;

            // 3. Infinite Wrapping Logic
            // Calculate distance from the original center offset
            const dy = group.position.y - yOffset;
            
            // If the ring moves past the top boundary, snap it to the bottom
            if (dy > halfHeight) {
                group.position.y -= totalHeight;
            } 
            // If the ring moves past the bottom boundary, snap it to the top
            else if (dy < -halfHeight) {
                group.position.y += totalHeight;
            }
        }

        // Smooth camera parallax
        const ease = CONFIG.motion.parallaxEase;
        currentRotX += (targetRotX - currentRotX) * ease;
        currentRotY += (targetRotY - currentRotY) * ease;

        camera.quaternion.setFromEuler(
            new THREE.Euler(currentRotX, currentRotY, 0, 'YXZ')
        );

        renderer.render(scene, camera);
    };

    animate();

    /*
     * Bucla nu se oprea niciodata. Pe telefon o pagina lasata deschisa intr-un
     * tab din fundal continua sa invarta hexagoanele: browserul incetineste
     * rAF, dar nu il opreste, si scena tot se deseneaza. O oprim de tot cat
     * timp pagina nu se vede si o repornim la intoarcere.
     */
    const onVisibility = () => {
        if (document.hidden) cancelAnimationFrame(rafId);
        else if (!reduceMotion.matches) animate();
    };
    document.addEventListener('visibilitychange', onVisibility);

    const cleanup = () => {
        cancelAnimationFrame(rafId);
        if (wantsParallax) window.removeEventListener('mousemove', onMouse);
        document.removeEventListener('visibilitychange', onVisibility);
        window.removeEventListener('resize', onResize);
        renderer.dispose();
        hexGeo.dispose();
        ringGroups.forEach(g => g.children.forEach((m: any) => m.material.dispose()));
        document.removeEventListener('astro:before-swap', cleanup);
        window.removeEventListener('theme-change', onThemeChange);
        (canvas as any)._initialized = false;
    };

    /*
     * Schimbarea temei repicteaza scena existenta; NU o reconstruieste.
     * renderer.dispose() elibereaza contextul WebGL legat de pânza, iar o pânza
     * poate da un singur context in toata viata ei — deci un initBackground()
     * de-al doilea pe acelasi <canvas> nu mai avea cum sa reuseasca, si fundalul
     * ramanea rupt dupa prima comutare.
     */
    const onThemeChange = () => {
        const next = themeColors();

        scene.background = new THREE.Color(next.background);
        if (scene.fog) scene.fog.color.set(next.fog);
        ambient.intensity = next.ambient;
        directionals.forEach((l, i) => {
            l.color.set(next.directional[i]);
            l.intensity = next.directionalIntensity[i];
        });

        ringGroups.forEach(group => group.children.forEach((mesh: any) => {
            mesh.material.color.set(pick(next.palette));
            mesh.material.opacity = next.opacity;
            mesh.material.transparent = next.opacity < 1;
            mesh.material.needsUpdate = true;
        }));
    };

    document.addEventListener('astro:before-swap', cleanup);
    window.addEventListener('theme-change', onThemeChange);
}

['astro:page-load', 'DOMContentLoaded'].forEach((ev) => {
    document.addEventListener(ev, initBackground);
});

</script>