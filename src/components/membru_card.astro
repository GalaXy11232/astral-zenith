---
const { name, department, image, tooltip = "" } = Astro.props;

const TOOLTIP_ABBREVIATIONS: Record<string, string> = {
    'UPB, AC': 'Universitatea POLITEHNICA București - Facultatea de Automatică și Calculatoare',
    'UPB, FIMM': 'Universitatea POLITEHNICA București - Facultatea de Inginerie Mecanică și Mecatronică',
    'CTO la Investimental': 'Chief Technology Officer la Investimental',
    'Producătoare de filme documentare': 'Producătoare de filme documentare',
    'Profesor la UPB ETTI': 'Profesor la Universitatea POLITEHNICA București - Facultatea de Electronică, Telecomunicații și Tehnologia Informației',
    'Manager Rhinotyres': 'Manager la compania Rhinotyres',
    'CEO Rhinotyres': 'Chief Executive Officer la compania Rhinotyres',
    'Country Sales Manager EATON': 'Country Sales Manager la compania EATON',
    'Profesor de Fizică': 'Profesor de Fizică la Colegiul Național "Grigore Moisil" din București'

};

/* Fallback pe eticheta insasi: o cheie care nu e in dictionar (sau are o
   litera pe dos, cum a fost "documnetare") deschidea la hover o caseta goala,
   fara niciun semn ca de fapt cautarea a dat gres. */
const tooltipText = TOOLTIP_ABBREVIATIONS[tooltip] || tooltip;
---

<article class="member-card glass glass-hover">
    <span class="glass-sheen" aria-hidden="true"></span>
    <div class="image-wrapper glass-inset">
        <img 
            src={image} 
            alt={`Portrait of ${name}`} 
            loading="lazy" 

            onerror = "this.src = '/assets/icons/membru no photo zenith.png'"
        />
    </div>
    <div class="info">
        <h3 class="name" translate="no">{name}</h3>
        <p class="department">{department}</p>

        <span class="facultate-tooltip"><i>{tooltip}</i>
        <div class="facultate-tooltiptext"> <i>{tooltipText}</i> </div>
        </span>
    </div>
</article>

<style>
    .member-card {
        --tooltip-color: rgb(var(--brand-900-rgb) / 0.55);
        --text-color: var(--glass-text);
    }

    .facultate-tooltiptext {
        position: absolute;
        left: 0; right: 0;
        margin: auto; margin-top: 1em;
        background: var(--tooltip-color);
        backdrop-filter: blur(16px) saturate(160%);
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        border: 1px solid var(--glass-border);
        box-shadow:
            0 8px 24px var(--shadow-soft),
            inset 0 1px 0 var(--glass-hilite);
        color: var(--text-color);
        border-radius: 15px;
        width: fit-content !important;
        padding: 5px 2em; font-size: 80%;
        opacity: 1; visibility: hidden;
        transition: .25s ease cubic-bezier(0.47, 0, 0.745, 0.715);
        z-index: 2;
    }
    .facultate-tooltiptext::after { /* arrow */
        content: "";
        position: absolute;
        bottom: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: transparent transparent var(--glass-border) transparent;
    }
    .facultate-tooltip { position: relative; }

    /* .glass pune backdrop-filter si isolation: isolate pe fiecare card, deci
       fiecare card e propriul context de stivuire: z-index-ul casetei se poate
       ridica doar peste continutul cardului ei, nu peste cardurile vecine.
       Cardurile fiind flex items in .team-grid, cele de dupa in DOM se deseneaza
       peste caseta care coboara din cardul curent. Ridicam intreg cardul cat e
       sub cursor — atunci si caseta lui trece peste randul urmator. */
    .member-card:hover { z-index: 5; }
    .facultate-tooltip > i { color: var(--accent-text); border-bottom: 1px dotted var(--glass-border-hover); cursor: help;}
    .facultate-tooltip:hover div { visibility: visible; opacity: 1;}

    
    /* sticla vine din .glass / .glass-hover (global.css) */
    .member-card {
        border-radius: 24px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 200px;
    }

    /* --- Image Container --- */
    .image-wrapper {
        width: 100%;

        aspect-ratio: 3 / 4;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        
        
        transition: transform 0.5s ease;
    }

    .member-card:hover .image-wrapper img {
        transform: scale(1.04);
    }

    
    .info {
        display: flex;
        flex-direction: column;
        gap: 6px;
        width: 100%;
    }

    .name {
        margin: 0;
        font-family: 'Prompt', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--glass-text);
        letter-spacing: -0.01em;

        text-shadow: 0 1px 12px var(--shadow-strong);
    }

    .department {
        margin: 0;
        font-family: 'Prompt', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        color: var(--glass-text-soft);
        line-height: 1.4;
        
        white-space: pre-wrap; 
    }
</style>