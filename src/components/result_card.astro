---
const { date, title,  image, imageAlt, scale_factor = 1} = Astro.props;
---

<article class="result-card">
    <div style = "margin-bottom: 6.7px;">
        <span class="result-card__date">{date}</span>
    </div>

    <div class="result-card__panel glass">
        <span class="glass-sheen" aria-hidden="true"></span>
        <div class="result-card__media">
        <img style = {`transform: scale(${scale_factor})`} src={image} alt={imageAlt ?? title} loading="lazy" />
        </div>

        <div class="result-card__content">
        <h3 class="result-card__title">{title}</h3>
        <div class="result-card__description">
            <slot />
        </div>
        </div>
    </div>
</article>

<style>
    .result-card {
        position: relative;
        padding-top: 1.85rem;
    }


    .result-card__date {
        position: absolute;
        top: 0; 
        right: 1.5rem;
        display: inline-block;
        padding: 0.4rem 1.1rem;
        background: linear-gradient(135deg, #a21caf, #9333ea);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        border-radius: 999px;
        box-shadow: 0 4px 10px rgba(126, 34, 206, 0.35);
        white-space: nowrap;
    }


    /* sticla vine din .glass (global.css) */
    .result-card__panel {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        border-radius: 1rem;
        padding: 1.5rem;
    }


    .result-card__panel::before {
        content: "";
        position: absolute;
        top: 2.1rem;
        right: -0.6rem;
        width: 1.2rem;
        height: 1.2rem;
        /* culoare explicita: `inherit` ar lua gradientul de sticla si ar arata
           rupt pe patratul rotit */
        background: rgba(255, 255, 255, 0.13);
        border-right: 1px solid var(--glass-border);
        border-top: 1px solid var(--glass-border);
        border-radius: 0.25rem;
        transform: rotate(45deg);
    }

    .result-card__media {
        flex: 0 0 auto;
        width: 6.5rem;
        height: auto;
        border-radius: 0.75rem;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        /* background: #ffffff; */
    }

    .result-card__media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .result-card__content {
        flex: 1 1 auto;
        min-width: 0;
    }

    .result-card__title {
        margin: 0 0 0.5rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--glass-text-soft);
    }

    .result-card__description {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.6;
        color: #e3dbf2;
        /* text-align: justify; */
        /* text-justify: inter-word; */
    }

    .result-card__description :global(p) {
        margin: 0 0 0.6em;
    }

    .result-card__description :global(p:last-child) {
        margin-bottom: 0;
    }


    @media (max-width: 640px) {
        .result-card {
            padding-top: 0;
        }

        .result-card__date {
            position: static;
            display: inline-block;
            margin-bottom: 0.75rem;
        }

        .result-card__panel {
            flex-direction: column;
            text-align: center;
        }

        .result-card__panel::before {
            display: none;
        }
    }
</style>