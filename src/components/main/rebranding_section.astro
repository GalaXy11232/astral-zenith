---

<section class="transformation-section">
<div class="content-container">
    
    
    <div class="logo-wrapper">
    <img src="assets/Branding Zenith/Sigla_SovaTech.png" alt="Sovatech Robotics" class="logo" />
    </div>

    <!-- Doua fisiere, nu unul recolorat: sagetile sunt SVG-uri trasate, cu
         culorile scrise in path-uri. Comutarea foloseste .logo-dark /
         .logo-light, aceeasi pereche ca siglele de mai jos (regulile sunt in
         navbar.css, dar se aplica global). alt="" pe amandoua: sageata e
         decorativa, iar cu text alternativ cititoarele de ecran ar anunta-o
         de doua ori. -->
    <div class="arrow-wrapper">
        <img class="animated-arrow logo-dark"  src="assets/sageata_dark.svg"  alt="" aria-hidden="true">
        <img class="animated-arrow logo-light" src="assets/sageata_light.svg" alt="" aria-hidden="true">
    </div>

    <div class="logo-wrapper">
        <img src="assets/Branding Zenith/Sigla_alb.png" alt="Zenith" class="logo logo-dark" />
        <img src="assets/Branding Zenith/Sigla_mov.png" alt="Zenith" class="logo logo-light" />
    </div>

</div>
</section>

<style>
.transformation-section {
    border-radius: 1.35rem;
    background: linear-gradient(90deg, rgb(var(--legacy-orange) / 0.42), rgb(var(--brand-400-rgb) / 0.42));
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    /* border: 1px solid rgba(193, 193, 193, 0.25); */
    box-shadow:
        0 0 0 1px rgb(var(--brand-500-rgb) / 0.08),
        0 24px 60px rgb(var(--brand-900-rgb) / 0.45),
        0 0 46px rgb(var(--brand-500-rgb) / 0.18);

    padding: 0 2rem 2rem 2rem;
    width: min(92vw, max(1050px, 80dvh));

    margin: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.content-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    max-width: 1200px;
    width: 100%;
}

.logo-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
}

.logo {
    max-width: 100%;
    height: auto;
    width: 280px; 
    object-fit: contain;
}


.arrow-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    transform: scale(.6, .5);
}

.arrow-wrapper img {
    --size: 150px;
    width: var(--size); height: var(--size);
}

.animated-arrow {
    animation: bounce-horizontal 2s ease-in-out infinite;
}

@keyframes bounce-horizontal {
    0%, 100% {
        transform: translateX(-15px);
    }
    50% {
        transform: translateX(15px);
    }
}


@media (max-width: 768px) {
    .transformation-section {
        background: linear-gradient(180deg, rgb(var(--legacy-orange-dark) / 0.42), rgb(var(--brand-400-rgb) / 0.42));
        width: 70vw;
    }
    .content-container {
        flex-direction: column;
        gap: 0 !important;
        padding-bottom: 1.67rem;
    }

    .animated-arrow {
        animation: bounce-vertical 2s ease-in-out infinite;
    }

    @keyframes bounce-vertical {
        0%, 100% {
            transform: translateY(-125px) rotate(90deg);
        }
        50% {
            transform: translateY(15px) rotate(90deg);
        }
    }
}
</style>