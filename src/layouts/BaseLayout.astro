---
import "../stylesheets/global.css";
import "../stylesheets/navbar.css";

const {
    title,
    user_scalable = true,
    /* Descrierea paginii. Intra in <meta name="description">, in og:description
       si in twitter:description — deci se scrie o singura data, per pagina. */
    description = 'Zenith 19084 — echipa de robotica FIRST Tech Challenge a Colegiului National „Grigore Moisil” din Bucuresti. Rezultate, activitati, galerie si parteneri.',
    /* Poza pentru previzualizarea linkurilor. Cale ABSOLUTA la build, din
       `site` din astro.config — Facebook/WhatsApp/Discord ignora caile
       relative si ar afisa link gol. */
    ogImage = '/assets/render.png',
} = Astro.props;

/* Astro.site vine din `site` in astro.config.mjs. Daca lipseste, canonical si
   og:url ies goale si previzualizarile se strica — de aceea e setat acolo. */
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL   = new URL(ogImage, Astro.site);

/* Titlul din tab si din rezultatele Google. Inainte se scria `<title> {title} </title>`
   cu spatii literale inauntru si fara nume de echipa, deci homepage-ul aparea
   in Google drept „Acasa”, fara niciun indiciu ca e vorba de Zenith. */
const SITE_NAME = 'Zenith 19084';
const fullTitle = title === 'Acasa' ? `${SITE_NAME} - Home` : `${title} | ${SITE_NAME}`;

import ClientRouter from "astro/components/ClientRouter.astro";
---
<html lang="ro">
	<head>
		<!-- Trebuie sa fie primul si sincron: pune data-theme inainte de
		     prima pictura, altfel pagina clipeste o data in tema gresita.
		     Intunericul e implicit, deci se scrie doar 'light'. IIFE, ca
		     ClientRouter reruleaza scripturile din <head> la fiecare swap
		     si un `const` la nivel de top ar arunca a doua oara. -->
		<script is:inline>
			(function () {
				try {
					if (localStorage.getItem('theme') === 'light')
						document.documentElement.dataset.theme = 'light';
				} catch (e) { /* localStorage blocat — ramane tema intunecata */ }
			})();
		</script>

		<meta charset="utf-8" />
		<link rel="icon" href="/tab_icon.ico" />
		<meta name="viewport" content=`width=device-width, initial-scale=1.0${!user_scalable ? ', user-scalable=no' : ''}` />
		<meta name="generator" content= {Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Previzualizarea linkului cand cineva da share pe Facebook, WhatsApp,
		     Discord sau Messenger. Fara ele iese un dreptunghi gri fara text —
		     iar pagina de presa exista tocmai ca sa fie trimisa mai departe. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Zenith 19084" />
		<meta property="og:locale" content="ro_RO" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Fara preconnect, fontul cere DNS + TLS abia dupa ce se parseaza
		     <link>-ul de mai jos: doua drumuri dus-intors in plus inainte de
		     prima litera desenata. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Doar greutatile folosite. Se cereau toate noua, si inca o data pe
		     toate in italic — optsprezece variante, din care site-ul foloseste
		     cinci (400, 500, 600, 700, 800) si niciun italic. Axa `ital,` a
		     disparut cu totul: fara ea, un <em> ratacit nu mai poate declansa
		     descarcarea unei fete in plus, il inclina browserul sintetic. -->
	    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800&display=swap" rel="stylesheet">

        <ClientRouter />
	</head>

    <body style="background-color: var(--page-bg);">
        <!-- Primul element focusabil din pagina. Fara el, cine navigheaza din
             tastatura trece prin cele 8 linkuri de meniu plus comutatoarele de
             tema si limba pe FIECARE pagina, inainte sa ajunga la continut.
             Ascuns pana primeste focus (vezi .skip-link in global.css). -->
        <a class="skip-link" href="#main-content">Sari la continut</a>
        <slot />
    </body>

    <script is:inline>
        window.gtranslateSettings = {
            "default_language": "ro",
            "native_language_names": true,
            // "languages": ["ro", "en", 'fr', 'de', 'ja', 'it'], 
            "languages": ['ro', 'en'],
            "wrapper_selector": ".gtranslate_wrapper",
            "switcher_horizontal_position": "right",
            "switcher_vertical_position": "bottom",
            "float_switcher_open_direction": "top",
            "flag_style": "3d"
        }
    </script>

    <script src="https://cdn.gtranslate.net/widgets/latest/flags.js" defer is:inline></script>
</html>

<script>
	document.addEventListener("astro:page-load", () => {
		const astro = document.querySelector("astro-dev-toolbar");
        const body = document.body;
		if (astro) 
			astro.style.display = "none";

        body.style.minHeight = '0'; // hardcoded bug fix ca isi lua min-height:100% on load for some reason
	})
</script>

<style is:global>
    #google_translate_element2,
    .skiptranslate:not(.glink) {
        display: none !important;
    }

    body {
        top: 0 !important;
    }

    .gtranslate_wrapper {
        display: flex;
        flex-direction: row;
    }
</style>

<!-- 3. ClientRouter lifecycle hooks -->
<script>
  // Before each swap: steal the entire wrapper out of the old DOM
  // and stash it on window so the new DOM can adopt it.
    document.addEventListener('astro:before-swap', (e) => {
        const wrapper = document.querySelector('.gtranslate_wrapper');
        if (wrapper) {
            window.__gtranslate_wrapper = wrapper;
            wrapper.remove(); // detach from old DOM so it doesn't get destroyed
        }
    });

  /*
   * ClientRouter inlocuieste atributele lui <html> cu cele ale paginii noi,
   * iar acelea vin din HTML-ul static, unde data-theme nu exista. Fara
   * randul asta tema deschisa sare inapoi pe intuneric la fiecare link
   * intern — dar NU si la reincarcare, ceea ce face bugul greu de vazut.
   */
    document.addEventListener('astro:after-swap', () => {
        try {
            document.documentElement.dataset.theme =
                localStorage.getItem('theme') === 'light' ? 'light' : '';
            if (!document.documentElement.dataset.theme)
                document.documentElement.removeAttribute('data-theme');
        } catch (e) { /* localStorage blocat */ }
    });

  // After each swap: re-inject the rescued wrapper into the new DOM.
  // The new page's .gtranslate_wrapper placeholder gets replaced.
  document.addEventListener('astro:after-swap', () => {
        const stashed = window.__gtranslate_wrapper;
        if (!stashed) return;

        const placeholder = document.querySelector('.gtranslate_wrapper');
        if (placeholder) {
            placeholder.replaceWith(stashed);
        } else {
            document.body.appendChild(stashed);
        }

        stashed.style.display = 'flex';
        stashed.style.flexDirection = 'row';
    });

    /**
     * Limba activa. Widgetul din flags.js (url_structure "none") isi tine starea
     * in localStorage.__GT_TRANSLATE_LANGS. Aici se citea cookie-ul googtrans,
     * care apartine vechiului Google Translate Element si nu se mai scrie de
     * nimeni — deci nu se reaplica nimic niciodata.
     */
    function active_language() {
        try {
            const stored = JSON.parse(localStorage.getItem('__GT_TRANSLATE_LANGS') || 'null');
            if (typeof stored?.tgtLang === 'string') return stored.tgtLang;
        } catch (e) { /* localStorage blocat sau JSON stricat */ }

        return null;
    }

    /*
     * Motorul de traducere se leaga de documentul pe care il gaseste cand se
     * initializeaza. Dupa un swap ClientRouter nu se mai regaseste in DOM-ul
     * nou: __GT.translator.translate() iese pe loc, fara eroare si fara sa
     * atinga nici macar <html lang>, deci pagina in care intri ramane in
     * romana.
     *
     * S-a incercat si repornirea lui pe loc, fara reincarcare: revert() chiar
     * ii sterge referinta catre nodul tradus, iar translate() de dupa
     * reconstruieste parcurgerea peste DOM-ul nou si intoarce true. Numai ca
     * traducerea tot nu ajunge la capat — translator.finished ramane false —
     * deci pagina ar fi ramas in romana de tot. Vezi reapply_translation() din
     * NavBar.astro, care acopera celelalte doua cazuri in care se pierde limba.
     *
     * Cat timp e activa o traducere, scoatem deci linkurile interne din
     * navigarea SPA. `data-astro-reload` face ClientRouter sa lase browserul sa
     * incarce pagina normal, iar la incarcare flags.js porneste motorul din nou
     * si reaplica limba salvata. Marcajul se pune la fiecare `astro:page-load`,
     * fiindca linkurile paginii noi vin proaspete din HTML-ul de pe server.
     */
    function mark_internal_links(event) {
        const gt = window.gtranslateSettings;

        // la comutare primim limba tinta in eveniment: localStorage inca n-a
        // fost scris de motor in momentul clicului
        const language = event?.detail?.language || active_language();
        const translated = !!(gt && language && language !== gt.default_language);

        document.querySelectorAll('a[href^="/"]').forEach((link) => {
            if (translated) link.setAttribute('data-astro-reload', '');
            else link.removeAttribute('data-astro-reload');
        });
    }

    document.addEventListener('astro:page-load', mark_internal_links);

    // butonul de limba din NavBar anunta comutarea, ca la 'theme-change':
    // linkurile trebuie remarcate imediat, nu abia la urmatorul page-load
    window.addEventListener('language-change', mark_internal_links);
</script>
