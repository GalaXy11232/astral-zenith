---
import BaseLayout from "../layouts/BaseLayout.astro"
import NavBar from "../components/NavBar.astro"
import Footer from "../components/footer.astro";
import Hexbackground from "../components/hexbackground.astro"

import ContactMethodCard from "../components/contact/ContactMethodCard.astro";
import { contactMethods, location } from '../data/contact-data';
---

<BaseLayout title = "Contact">
    <NavBar activeLink = {7} />
    <Hexbackground />
    <main class="contact-page">
        <section class="contact-hero">
            <h1 class="contact-hero__title">Contactează-ne</h1>
            <p class="contact-hero__eyebrow">
                pentru orice întrebare ai despre echipă, proiecte sau colaborări
            </p>
        </section>

        <section class="contact-methods" aria-label="Metode de contact">
            <div class="contact-methods__grid">
            {
                contactMethods.map((method) => (
                <ContactMethodCard
                    label={method.label}
                    value={method.value}
                    href={method.href}
                    icon={method.icon}
                    external={method.external}
                />
                ))
            }
            </div>
        </section>

        <section class="contact-location">
            <h2 class="contact-location__title">Locație</h2>
            <div class="contact-location__grid">
                <div class="contact-location__info glass">
                    <span class="glass-sheen" aria-hidden="true"></span>

                    <!-- Sigla reala a scolii, nu culorile ei imprumutate pe
                         caseta: referinta e explicita, iar restul casetei
                         ramane in tema site-ului. -->
                    <span class="contact-location__crest">
                        <img
                            src={location.schoolLogo}
                            alt={location.schoolName}
                            width="72"
                            height="72"
                            loading="lazy"
                            decoding="async"
                        />
                    </span>

                    <dl class="contact-location__details">
                        <dt class="contact-location__label">Liceul</dt>
                        <dd class="contact-location__value">{location.schoolName}</dd>
                        <dt class="contact-location__label">Adresă</dt>
                        <dd class="contact-location__value">{location.address}</dd>
                    </dl>
                </div>

                <div class="contact-location__map glass">
                    <iframe
                        title="Harta — Colegiul Național „Grigore Moisil”"
                        src={location.mapEmbedUrl}
                        width="100%"
                        height="100%"
                        style="border:0;"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen
                    ></iframe>
                </div>
            </div>
        </section>
    </main>

    <Footer onContactPage={true} />
</BaseLayout>

<style is:global>
    .contact-page {
        max-width: 68rem;
        margin-inline: auto;
        padding: 2rem 1.5rem 5rem;
    }

    .contact-hero {
        text-align: center;
        max-width: 40rem;
        margin: 0 auto 3.5rem;
    }

    .contact-hero__eyebrow {
        /* font-family: "Space Grotesk", system-ui, sans-serif; */
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-text);
        margin: 0 0 0.6rem;
    }

    .contact-hero__title {
        /* font-family: "Space Grotesk", system-ui, sans-serif; */
        font-weight: 700;
        font-size: clamp(2.2rem, 5vw, 4rem);
        line-height: 1.1;
        margin: 0 0 0.9rem;
        /* Era un gradient --brand-800 → --brand-700 → --brand-500 taiat pe
           text. Primele doua opriri sunt movuri inchise, gandite pentru fundal
           deschis: pe fundalul intunecat al site-ului (#0b0714) jumatatea din
           stanga a titlului practic disparea. Acum e plin, in aceeasi culoare
           ca restul textului mov din site. */
        color: var(--accent-text);
    }

    .contact-hero__subtitle {
        margin: 0;
        font-size: 1.12rem;
        line-height: 1.5;
        color: var(--accent-text);
    }

    .contact-methods {
        margin-bottom: 4rem;
    }

    .contact-methods__grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.35rem;
    }

    .contact-location__title {
        /* font-family: "Space Grotesk", system-ui, sans-serif; */
        font-weight: 700;
        font-size: 1.6rem;
        color: var(--accent-text);
        margin: 0 0 1.5rem;
    }

    .contact-location__grid {
        display: grid;
        grid-template-columns: minmax(240px, 0.85fr) minmax(280px, 1.15fr);
        gap: 1.5rem;
        align-items: stretch;
    }

    /* sticla vine din .glass (global.css) */
    .contact-location__info {
        display: flex;
        /* cardul se intinde pe inaltimea hartii (align-items: stretch pe grid),
           deci continutul trebuie centrat pe verticala — altfel sta lipit sus */
        align-items: center;
        gap: 1rem;
        padding: 1.75rem;
        border-radius: 1.25rem;
    }

    /* Placa de sub sigla: o suprafata deschisa, ca sa se vada si baza neagra
       a scutului, care altfel s-ar pierde in fundalul intunecat. */
    .contact-location__crest {
        flex: 0 0 auto;
        width: 4.75rem;
        height: 4.75rem;
        padding: 0.45rem;
        border-radius: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--glass-fill-strong);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        box-shadow: inset 0 0 0 1px var(--glass-hilite);
    }

    .contact-location__crest img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    /* `flex: 1` ca textul sa ocupe latimea ramasa — fara el se ingramadea in
       stanga si jumatate de caseta ramanea goala. */
    .contact-location__details {
        flex: 1 1 auto;
        min-width: 0;
        margin: 0;
    }

    .contact-location__label {
        margin: 0;
        /* font-family: "Space Grotesk", system-ui, sans-serif; */
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--glass-text-soft);
    }

    .contact-location__value {
        margin: 0 0 0.9rem;
        font-size: 1rem;
        font-weight: 600;
        color: var(--glass-text);
        width: auto;
    }

    .contact-location__value:last-child {
        margin-bottom: 0;
    }

    /* Cand e loc, eticheta si valoarea stau pe acelasi rand, aliniate pe o
       coloana comuna — asa textul se intinde pe toata latimea in loc sa
       lase un gol in dreapta. */
    @media (min-width: 560px) {
        .contact-location__details {
            display: grid;
            grid-template-columns: auto 1fr;
            column-gap: 1.25rem;
            row-gap: 0.7rem;
            align-items: baseline;
        }

        .contact-location__label {
            text-align: right;
            padding-top: 0.1rem;
        }

        .contact-location__value,
        .contact-location__value:last-child {
            margin: 0;
        }
    }

    /* sticla vine din .glass (global.css) */
    .contact-location__map {
        border-radius: 1.25rem;
        overflow: hidden;
        min-height: 260px;
    }

    .contact-location__map iframe {
        display: block;
    }

    @media (max-width: 780px) {
        .contact-location__grid {
            grid-template-columns: 1fr;
        }

        .contact-location__map {
            min-height: 320px;
        }
    }

    @media (max-width: 480px) {
        .contact-location__info {
            flex-direction: column;
        }
    }
</style>
