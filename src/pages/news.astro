---
import BaseLayout from "../layouts/BaseLayout.astro"
import NavBar from "../components/NavBar.astro"
import Footer from "../components/footer.astro";
import Hexbackground from "../components/hexbackground.astro"

import MediaEvent from '../components/media/MediaEvent.astro';
import MediaLink  from '../components/media/MediaLink.astro';
---


<BaseLayout title = "Presă"
    description="Zenith 19084 in presa: articole, interviuri si aparitii media despre echipa de robotica a Colegiului „Grigore Moisil”.">
    <NavBar activeLink = {6} />
    <Hexbackground />

    <!-- Titlul paginii, doar pentru cititoarele de ecran si pentru Google:
         designul nu prevede un h1 vizibil aici, dar pagina trebuie sa aiba unul. -->
    <h1 class="sr-only">Zenith 19084 in presa</h1>

    <main id="main-content">

    <MediaEvent
        title="Smart Urban Mobility - Interviu Antena 3 CNN"
        date="11 octombrie 2026"
        cover="/assets/stiri/smart-urban-mobility/cover.jpeg"
        coverAlt="Interviul Antena 3 CNN la standul echipei Zenith, la Meet the Future"
        coverFocus="50% 35%"
        uid="event-smart-urban-mobility"
    >
        <h3 class="me-section-label">Articole & surse</h3>
        <div class="me-grid">
            <MediaLink
                href="https://www.antena3.ro/conferinte/smart-urban-mobility-elevii-de-la-colegiul-grigore-moisil-au-construit-un-submarin-autonom-care-exploreaza-zone-greu-accesibile-806722.html"
                source="Antena 3 CNN"
                label="Elevii de la Colegiul „Grigore Moisil” au construit un submarin autonom care explorează zone greu accesibile"
            />
            <MediaLink
                href="https://www.antena3.ro/life/timp-liber/roboti-construiti-de-elevi-si-mobilitatea-urmatorilor-cinci-ani-meet-the-future-smart-urban-mobility-in-cadrul-sab-accesorii-806571.html"
                source="Antena 3 CNN"
                label="Roboți construiți de elevi și mobilitatea următorilor cinci ani: „Meet the Future”"
            />
            <MediaLink
                href="https://incomemagazine.ro/roboti-construiti-de-elevi-si-mobilitatea-urmatorilor-cinci-ani-meet-the-future-incheie-smart-urban-mobility-in-cadrul-sab-accesorii/?amp=1"
                source="Income Magazine"
                label="„Meet the Future” încheie Smart Urban Mobility, în cadrul SAB & Accesorii"
            />
            <MediaLink
                href="https://www.instagram.com/p/DeWt96AAMJL/"
                source="Instagram"
                label="Zenith la Meet the Future - Smart Urban Mobility"
            />
        </div>
    </MediaEvent>

    <MediaEvent
        title="Istanbul Premier Event - Premiul Inspire 2"
        date="26 - 28 iunie 2026"
        cover="/assets/stiri/istanbul/thumbnail.jpeg"
        uid="event-istanbul"
    >
        <h3 class="me-section-label">Articole & surse</h3>
        <div class="me-grid">
            <!-- <MediaLink 
                href="https://www.ziar.com/news=17680422" 
                source="Ziar.com" 
                label="Performanță de elită pentru echipa de robotică Zenith" 
            /> -->
            <MediaLink 
                href="https://www.news.ro/edu-news/performanta-elita-echipa-robotica-zenith-colegiul-national-grigore-moisil-capitala-membrii-echipei-au-obtinut-locul-ii-categoria-inspire-unei-competitii-profil-istanbul-foto-1922402202102026071722502955"  
                source="News.ro"   
                label="Performanţă de elită pentru echipa de robotică Zenith" 
            />

            <MediaLink 
                href="https://financialintelligence.ro/performanta-de-elita-pentru-echipa-de-robotica-zenith-de-la-colegiul-national-grigore-moisil-la-ftc-premier-event-istanbul-2026/"
                source="Financial Intelligence"   
                label="Performanţă de elită pentru echipa de robotică Zenith" 
            />
            <MediaLink 
                href="https://rotimes.ro/article/2026-07-02-bucharest-students-win-second-place-at-international-robotics-event"
                source="RoTimes"   
                label="Elevi din București au obținut locul doi la o competiție internațională de robotică" 
            />
        </div>
    </MediaEvent>

    <MediaEvent
        title="Interviu Prima News - Viitor pentru România"
        date="26 - 28 iunie 2026"
        cover="/assets/stiri/prima/prima-news-2.jpeg"
        uid="event-prima-news"
    >
        <h3 class="me-section-label">Surse</h3>
        <div class="me-grid">
            <MediaLink 
                href = "https://www.youtube.com/watch?v=gfCv_WEXd-U"
                source="Prima News"   
                label = "Viitor pentru România: Robotică și viitor | Zenith, Colegiul „Grigore Moisil”" 
            />
        </div>
    </MediaEvent>
    </main>


    <Footer />
</BaseLayout>