---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/footer.astro";
import GalleryImageVisualizer from "../components/gallery_image_visualizer.astro";
import Hexbackground from "../components/hexbackground.astro";
---

<BaseLayout title="Galerie" user_scalable = {false}>
    <NavBar activeLink={5} />

    <Hexbackground />
    <GalleryImageVisualizer />
    <div class="gallery" id="gallery-root">
        <div class="gallery-loading"></div>
    </div>

    <Footer />
</BaseLayout>

<style is:global>
    .gallery-folder {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin: 1rem;
        margin-bottom: 2.5rem;
    }

    /* fara asta mesajele de loading/eroare erau text negru pe fundal #111 */
    .gallery-loading {
        text-align: center;
        padding: 4rem 1.5rem;
        color: #d9c7ee;
        font-size: 1.05rem;
        font-weight: 500;
    }

    /* --- titlul-buton --- */
    .folder-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        background: none;
        border: none;
        padding: 0.2rem;
        font: inherit;
        color: inherit;
        cursor: pointer;
    }

    .folder-toggle:focus-visible {
        outline: 2px solid var(--glass-text-soft);
        outline-offset: 6px;
        border-radius: 10px;
    }

    .folder-chevron {
        flex: 0 0 auto;
        width: 1.5rem;
        height: 1.5rem;
        color: var(--glass-text-soft);
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .folder-chevron svg { display: block; width: 100%; height: 100%; }

    .folder-toggle[aria-expanded="true"] .folder-chevron {
        transform: rotate(180deg);
    }

    /* --- panoul care coboara de sub titlu --- */
    .wheel-panel {
        width: 100%;
        height: 0;
        overflow: hidden;
        transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Continutul porneste tras complet in sus, deci pe masura ce panoul creste
       roata pare ca iese de sub titlu. */
    .wheel-inner {
        transform: translateY(-100%);
        opacity: 0;
        transition:
            transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.35s ease;
    }

    .wheel-panel[data-open="true"] .wheel-inner {
        transform: translateY(0);
        opacity: 1;
    }

    /* --- roata de poze --- */
    .wheel {
        position: relative;
        width: 100%;
        max-width: 1400px;
        height: clamp(320px, 52vh, 560px);
        margin: 0 auto;
        overflow: hidden;
        cursor: grab;
        /* pointer events pe container: drag orizontal fara sa blocheze
           scroll-ul vertical al paginii */
        touch-action: pan-y;
    }

    .wheel:active { cursor: grabbing; }

    .wheel:focus-visible {
        outline: 2px solid var(--glass-text-soft);
        outline-offset: 4px;
        border-radius: 12px;
    }

    .wheel canvas {
        display: block;
        width: 100%;
        height: 100%;
    }

    .wheel-hint {
        text-align: center;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--glass-text-dim);
        margin: 0.35rem 0 0;
    }

    /* placeholderele pe care le foloseste vizualizatorul pentru sageti;
       nu se incarca niciodata, au doar data-src */
    .wheel-index { display: none; }

    @media (prefers-reduced-motion: reduce) {
        .wheel-panel,
        .wheel-inner,
        .folder-chevron { transition: none; }
    }
</style>

<script>
import { CircularWheel } from '../utils/circular_gallery';

interface FolderData {
    name: string;
    folderRaw: string;
    url: string;
    images: string[];
}

interface Entry {
    button: HTMLButtonElement;
    panel: HTMLElement;
    wheelEl: HTMLElement;
    index: HTMLElement;
    items: { image: string }[];
}

// O SINGURA roata pentru toata pagina. Fiindca doar un folder e deschis odata,
// nu mai avem nevoie de pool, de IntersectionObserver sau de reciclare de
// contexte — exista un singur context WebGL si un singur set de texturi.
let wheel: CircularWheel | null = null;
let openEntry: Entry | null = null;
let collapseTimer = 0;
let expandTimer = 0;

const CHEVRON = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

function openFullView(img: HTMLImageElement) {
    const visualizer = document.getElementById('image-visualizer') as HTMLImageElement | null;
    if (!visualizer) return;
    const container = visualizer.parentElement as HTMLDivElement;

    window.dispatchEvent(new CustomEvent('open-image-visualizer', {
        detail: {
            identifier: img.dataset.identifier,
            index: img.dataset.index,
        }
    }));

    visualizer.src = img.dataset.src ?? img.src; // use real src
    visualizer.setAttribute('data-visible', 'true');
    container.style.zIndex = '100';
    container.style.background = '#111d';
}

function buildSection(folder: FolderData, i: number): Entry | null {
    const section = document.createElement('section');
    section.className = 'gallery-folder';

    const panelId = `wheel-panel-${i}`;

    const titleContainer = document.createElement('div');
    titleContainer.className = 'title-container';

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'folder-toggle';
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-controls', panelId);

    const span = document.createElement('span');
    span.className = 'title-underline';
    span.textContent = folder.name;
    button.appendChild(span);

    const chevron = document.createElement('span');
    chevron.className = 'folder-chevron';
    chevron.innerHTML = CHEVRON;
    button.appendChild(chevron);

    titleContainer.appendChild(button);
    section.appendChild(titleContainer);

    if (folder.images.length === 0) {
        const p = document.createElement('p');
        p.className = 'gallery-loading';
        p.textContent = 'No images found.';
        section.appendChild(p);
        document.getElementById('gallery-root')!.appendChild(section);
        return null;
    }

    const sources = folder.images.map(
        name => `${folder.url}/${encodeURIComponent(name)}`
    );

    const panel = document.createElement('div');
    panel.className = 'wheel-panel';
    panel.id = panelId;
    panel.dataset.open = 'false';

    const inner = document.createElement('div');
    inner.className = 'wheel-inner';

    // Placeholdere ascunse: vizualizatorul existent cauta
    // [data-identifier="..."] ca sa stie ce sa arate la sageata stanga/dreapta.
    // Nu au src, doar data-src, deci nu descarca nimic.
    const index = document.createElement('div');
    index.className = 'wheel-index';
    sources.forEach((src, imgIndex) => {
        const img = document.createElement('img');
        img.dataset.identifier = folder.name;
        img.dataset.index = String(imgIndex);
        img.dataset.src = src;
        img.alt = '';
        index.appendChild(img);
    });
    inner.appendChild(index);

    const wheelEl = document.createElement('div');
    wheelEl.className = 'wheel';
    wheelEl.tabIndex = 0;
    wheelEl.setAttribute('role', 'region');
    wheelEl.setAttribute('aria-label',
        `${folder.name} — galerie rotativa. Trage cu mouse-ul sau foloseste sagetile stanga/dreapta.`);
    inner.appendChild(wheelEl);

    const hint = document.createElement('p');
    hint.className = 'wheel-hint';
    hint.textContent = 'trage pentru a roti · click pentru a mări';
    inner.appendChild(hint);

    panel.appendChild(inner);
    section.appendChild(panel);
    document.getElementById('gallery-root')!.appendChild(section);

    const entry: Entry = {
        button, panel, wheelEl, index,
        items: sources.map(image => ({ image }))
    };

    button.addEventListener('click', () => toggle(entry));
    return entry;
}

function collapse(entry: Entry) {
    entry.panel.style.height = entry.panel.scrollHeight + 'px';
    void entry.panel.offsetHeight; // forteaza reflow ca tranzitia sa porneasca
    entry.panel.style.height = '0px';
    entry.panel.dataset.open = 'false';
    entry.button.setAttribute('aria-expanded', 'false');
}

function expand(entry: Entry) {
    entry.panel.style.height = '0px';
    void entry.panel.offsetHeight; // reflow: fara el prima deschidere ar sari direct la final

    entry.panel.dataset.open = 'true';
    entry.button.setAttribute('aria-expanded', 'true');
    entry.panel.style.height = entry.panel.scrollHeight + 'px';

    // Dupa animatie lasam inaltimea libera, ca redimensionarea ferestrei sa nu
    // taie roata (are inaltimea in vh). Timerul e rezerva pentru cazul in care
    // transitionend nu se declanseaza (reduced-motion, tab in fundal).
    const release = () => {
        if (entry.panel.dataset.open === 'true') entry.panel.style.height = 'auto';
    };

    const onDone = (e: TransitionEvent) => {
        if (e.target !== entry.panel || e.propertyName !== 'height') return;
        entry.panel.removeEventListener('transitionend', onDone);
        window.clearTimeout(expandTimer);
        release();
    };

    entry.panel.addEventListener('transitionend', onDone);
    window.clearTimeout(expandTimer);
    expandTimer = window.setTimeout(release, 700);
}

function open(entry: Entry) {
    if (openEntry === entry) return;

    if (openEntry) {
        collapse(openEntry);
        openEntry = null;
    }

    // roata se creeaza la prima deschidere si traieste pana la parasirea paginii
    if (!wheel) wheel = new CircularWheel({ bend: 3, borderRadius: 0.05 });

    window.clearTimeout(collapseTimer);
    wheel.detach();
    wheel.attach(entry.wheelEl, entry.items, (i: number) => {
        const target = entry.index.children[i] as HTMLImageElement | undefined;
        if (target) openFullView(target);
    });

    expand(entry);
    openEntry = entry;
}

function close(entry: Entry) {
    collapse(entry);
    openEntry = null;

    // detasam abia dupa ce panoul s-a strans, altfel panza dispare brusc
    // in mijlocul animatiei
    window.clearTimeout(collapseTimer);
    collapseTimer = window.setTimeout(() => {
        if (!openEntry) wheel?.detach();
    }, 500);
}

function toggle(entry: Entry) {
    if (openEntry === entry) close(entry);
    else open(entry);
}

function teardown() {
    window.clearTimeout(collapseTimer);
    window.clearTimeout(expandTimer);
    wheel?.destroy();
    wheel = null;
    openEntry = null;
}

async function initGallery() {
    const root = document.getElementById('gallery-root');
    if (!root) return;

    // avoid double-init on astro:page-load
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    root.innerHTML = '<div class="gallery-loading">Se încarcă galeria...</div>';

    let folders: FolderData[];
    try {
        const res = await fetch('/api/gallery.json');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        folders = await res.json();
    } catch (err) {
        console.error('Failed to load folder list:', err);
        root.innerHTML = '<div class="gallery-loading">Eroare la încărcarea galeriei.</div>';
        return;
    }

    root.innerHTML = '';

    const entries: Entry[] = [];
    folders.forEach((folder, i) => {
        const entry = buildSection(folder, i);
        if (entry) entries.push(entry);
    });

    // primul folder (cel mai recent) e deschis din start
    if (entries.length) open(entries[0]);
}

document.addEventListener('astro:before-swap', teardown);

// fallback for non-Astro-routed first load
['astro:page-load', 'DOMContentLoaded'].forEach((ev) => {
    document.addEventListener(ev, initGallery);
});
</script>
