---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/footer.astro";
import GalleryImageVisualizer from "../components/gallery_image_visualizer.astro";
import Hexbackground from "../components/hexbackground.astro";
---

<BaseLayout title="Galerie" user_scalable = {false}>
    <NavBar activeLink={5} />

    <Hexbackground />
    <GalleryImageVisualizer />
    <div class="gallery" id="gallery-root">
        <div class="gallery-loading"></div>
    </div>

    <Footer />
</BaseLayout>

<style is:global>
    .gallery-folder {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin: 1rem;
        margin-bottom: 3.5rem;
    }

    /* fara asta mesajele de loading/eroare erau text negru pe fundal #111 */
    .gallery-loading {
        text-align: center;
        padding: 4rem 1.5rem;
        color: #d9c7ee;
        font-size: 1.05rem;
        font-weight: 500;
    }

    /* --- titlul-buton --- */
    .folder-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        background: none;
        border: none;
        padding: 0.2rem;
        font: inherit;
        color: inherit;
        cursor: pointer;
    }

    .folder-toggle:focus-visible {
        outline: 2px solid var(--glass-text-soft);
        outline-offset: 6px;
        border-radius: 10px;
    }

    .folder-chevron {
        flex: 0 0 auto;
        width: 1.5rem;
        height: 1.5rem;
        color: var(--glass-text-soft);
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .folder-chevron svg { display: block; width: 100%; height: 100%; }

    .folder-toggle[aria-expanded="true"] .folder-chevron {
        transform: rotate(180deg);
    }

    /* --- panoul care coboara de sub titlu --- */
    .wheel-panel {
        width: 100%;
        height: 0;
        overflow: hidden;
        transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Continutul porneste tras complet in sus, deci pe masura ce panoul creste
       roata pare ca iese de sub titlu. */
    .wheel-inner {
        /* padding, nu margine pe ultimul copil: scrollHeight — pe care se
           bazeaza animatia panoului — nu socoteste marginea de jos a ultimului
           element, si butonul ramanea taiat de overflow: hidden */
        padding-bottom: 2.5rem;
        transform: translateY(-100%);
        opacity: 0;
        transition:
            transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.35s ease;
    }

    .wheel-panel[data-open="true"] .wheel-inner {
        transform: translateY(0);
        opacity: 1;
    }

    /* --- roata de poze --- */
    .wheel {
        position: relative;
        width: 100%;
        max-width: 1400px;
        height: clamp(320px, 52vh, 560px);
        margin: 0 auto;
        overflow: hidden;
        cursor: grab;
        /* pointer events pe container: drag orizontal fara sa blocheze
           scroll-ul vertical al paginii */
        touch-action: pan-y;
    }

    .wheel:active { cursor: grabbing; }

    .wheel:focus-visible {
        outline: 2px solid var(--glass-text-soft);
        outline-offset: 4px;
        border-radius: 12px;
    }

    .wheel canvas {
        display: block;
        width: 100%;
        height: 100%;
    }

    .wheel-hint {
        text-align: center;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--glass-text-dim);
        margin: 0.35rem 0 0;
    }

    /* Aceleasi elemente <img> servesc doua scopuri: in modul roata sunt doar
       evidenta pe care o citeste vizualizatorul la sagetile stanga/dreapta
       (ascunse, fara src, deci nu descarca nimic), iar in modul grila devin
       chiar grila. Asa nu exista doua seturi de imagini de tinut sincronizate. */
    .folder-grid { display: none; }

    [data-view="grid"] .folder-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
        padding: 0.5rem 0;
    }

    [data-view="grid"] .wheel { display: none; }

    .square-image {
        width: 250px;
        height: 250px;
        object-fit: cover;
        transition: .3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 0 10px black;
        display: block;
        background: #222;
        border-radius: 10px;
    }

    .square-image:hover {
        transform: scale(1.05);
        border-radius: 20px;
        box-shadow: 0 0 20px var(--primary), 0 0 20px var(--primary);
        cursor: pointer;
    }

    /* --- comutatorul roata / grila --- */
    .view-toggle {
        /* flex, nu inline-flex: `margin: auto` nu centreaza elementele inline.
           width: fit-content il tine stramt in loc sa se intinda pe tot randul. */
        display: flex;
        width: fit-content;
        align-items: center;
        gap: 0.6rem;
        margin: 1.4rem auto 0;
        padding: 0.8rem 1.75rem;
        border-radius: 999px;
        font: inherit;
        font-size: 0.92rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--glass-text);
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: background 0.25s ease, border-color 0.25s ease;
    }

    .view-toggle:hover {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.34);
    }

    .view-toggle:focus-visible {
        outline: 2px solid var(--glass-text-soft);
        outline-offset: 3px;
    }

    .view-toggle svg { width: 1.2rem; height: 1.2rem; display: block; }

    @media (prefers-reduced-motion: reduce) {
        .wheel-panel,
        .wheel-inner,
        .square-image,
        .view-toggle,
        .folder-chevron { transition: none; }
    }
</style>

<script>
import { CircularWheel } from '../utils/circular_gallery';

interface FolderData {
    name: string;
    folderRaw: string;
    url: string;
    images: string[];
}

interface Entry {
    button: HTMLButtonElement;
    panel: HTMLElement;
    inner: HTMLElement;
    wheelEl: HTMLElement;
    grid: HTMLElement;
    hint: HTMLElement;
    viewToggle: HTMLButtonElement;
    items: { image: string }[];
}

type ViewMode = 'wheel' | 'grid';

// O SINGURA roata pentru toata pagina. Fiindca doar un folder e deschis odata,
// nu avem nevoie de pool, de IntersectionObserver pentru sectiuni sau de
// reciclare de contexte — exista un singur context WebGL si un singur set de
// texturi.
let wheel: CircularWheel | null = null;
let openEntry: Entry | null = null;
let collapseTimer = 0;
let expandTimer = 0;

// Modul e GLOBAL pe durata vizitei: daca alegi grila, ramai in grila si cand
// deschizi alt folder. Se reseteaza pe roata la fiecare intrare in pagina
// (vezi initGallery) — modulele ES raman in cache intre navigarile ClientRouter,
// deci fara resetare alegerea ar fi supravietuit iesirii din tab.
const DEFAULT_VIEW: ViewMode = 'wheel';
let viewMode: ViewMode = DEFAULT_VIEW;
let lazyObserver: IntersectionObserver | null = null;

const entries: Entry[] = [];

const CHEVRON = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

const ICON_GRID = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
    <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
    <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
    <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
</svg>`;

const ICON_WHEEL = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
</svg>`;

const HINT = {
    wheel: 'trage pentru a roti · click pentru a mări',
    grid: 'click pe o poză pentru a o mări'
};

function openFullView(img: HTMLImageElement) {
    const visualizer = document.getElementById('image-visualizer') as HTMLImageElement | null;
    if (!visualizer) return;
    const container = visualizer.parentElement as HTMLDivElement;

    window.dispatchEvent(new CustomEvent('open-image-visualizer', {
        detail: {
            identifier: img.dataset.identifier,
            index: img.dataset.index,
        }
    }));

    visualizer.src = img.dataset.src ?? img.src; // use real src
    visualizer.setAttribute('data-visible', 'true');
    container.style.zIndex = '100';
    container.style.background = '#111d';
}

// Incarca pozele grilei abia cand se apropie de ecran. In modul roata imaginile
// n-au src deloc, deci nu costa nimic.
function getLazyObserver(): IntersectionObserver {
    if (lazyObserver) return lazyObserver;

    lazyObserver = new IntersectionObserver((records, observer) => {
        records.forEach(record => {
            if (!record.isIntersecting) return;
            const img = record.target as HTMLImageElement;
            const real = img.dataset.src;
            if (!real) { observer.unobserve(img); return; }

            img.src = real;
            observer.unobserve(img);
        });
    }, { rootMargin: '400px', threshold: 0 });

    return lazyObserver;
}

function buildSection(folder: FolderData, i: number): Entry | null {
    const root = document.getElementById('gallery-root')!;

    const section = document.createElement('section');
    section.className = 'gallery-folder';

    const panelId = `wheel-panel-${i}`;

    const titleContainer = document.createElement('div');
    titleContainer.className = 'title-container';

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'folder-toggle';
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-controls', panelId);

    const span = document.createElement('span');
    span.className = 'title-underline';
    span.textContent = folder.name;
    button.appendChild(span);

    const chevron = document.createElement('span');
    chevron.className = 'folder-chevron';
    chevron.innerHTML = CHEVRON;
    button.appendChild(chevron);

    titleContainer.appendChild(button);
    section.appendChild(titleContainer);

    if (folder.images.length === 0) {
        const p = document.createElement('p');
        p.className = 'gallery-loading';
        p.textContent = 'No images found.';
        section.appendChild(p);
        root.appendChild(section);
        return null;
    }

    const sources = folder.images.map(
        name => `${folder.url}/${encodeURIComponent(name)}`
    );

    const panel = document.createElement('div');
    panel.className = 'wheel-panel';
    panel.id = panelId;
    panel.dataset.open = 'false';

    const inner = document.createElement('div');
    inner.className = 'wheel-inner';
    inner.dataset.view = viewMode;

    const wheelEl = document.createElement('div');
    wheelEl.className = 'wheel';
    wheelEl.tabIndex = 0;
    wheelEl.setAttribute('role', 'region');
    wheelEl.setAttribute('aria-label',
        `${folder.name} — galerie rotativa. Trage cu mouse-ul sau foloseste sagetile stanga/dreapta.`);
    inner.appendChild(wheelEl);

    // Aceleasi <img> sunt si evidenta citita de vizualizator la sageti, si
    // grila propriu-zisa. Pornesc fara src, doar cu data-src.
    const grid = document.createElement('div');
    grid.className = 'folder-grid';
    sources.forEach((src, imgIndex) => {
        const img = document.createElement('img');
        img.className = 'square-image';
        img.alt = `${folder.name} — poza ${imgIndex + 1}`;
        img.decoding = 'async';
        img.draggable = false;
        img.dataset.identifier = folder.name;
        img.dataset.index = String(imgIndex);
        img.dataset.src = src;
        img.addEventListener('click', () => openFullView(img));
        grid.appendChild(img);
    });
    inner.appendChild(grid);

    const hint = document.createElement('p');
    hint.className = 'wheel-hint';
    hint.textContent = HINT[viewMode];
    inner.appendChild(hint);

    const viewToggle = document.createElement('button');
    viewToggle.type = 'button';
    viewToggle.className = 'view-toggle';
    inner.appendChild(viewToggle);

    panel.appendChild(inner);
    section.appendChild(panel);
    root.appendChild(section);

    const entry: Entry = {
        button, panel, inner, wheelEl, grid, hint, viewToggle,
        items: sources.map(image => ({ image }))
    };

    button.addEventListener('click', () => toggle(entry));
    viewToggle.addEventListener('click', () => {
        setView(viewMode === 'wheel' ? 'grid' : 'wheel');
    });

    paintToggle(entry);
    return entry;
}

/** Butonul arata unde te DUCI, nu unde esti. */
function paintToggle(entry: Entry) {
    const goingToGrid = viewMode === 'wheel';
    entry.viewToggle.innerHTML =
        (goingToGrid ? ICON_GRID : ICON_WHEEL) +
        `<span>${goingToGrid ? 'Grilă' : 'Roată'}</span>`;
    entry.viewToggle.setAttribute('aria-label',
        goingToGrid ? 'Comută la vizualizare grilă' : 'Comută la vizualizare roată');
}

function mountView(entry: Entry) {
    if (viewMode === 'wheel') {
        if (!wheel) wheel = new CircularWheel({ bend: 3, borderRadius: 0.05 });
        window.clearTimeout(collapseTimer);
        wheel.attach(entry.wheelEl, entry.items, (i: number) => {
            const target = entry.grid.children[i] as HTMLImageElement | undefined;
            if (target) openFullView(target);
        });
    } else {
        // grila: pornim incarcarea lenesa a pozelor acestei sectiuni
        const observer = getLazyObserver();
        Array.from(entry.grid.children).forEach(img => observer.observe(img));
    }
}

function unmountView(entry: Entry) {
    wheel?.detach();
    const observer = lazyObserver;
    if (observer) Array.from(entry.grid.children).forEach(img => observer.unobserve(img));
}

function collapse(entry: Entry) {
    entry.panel.style.height = entry.panel.scrollHeight + 'px';
    void entry.panel.offsetHeight; // forteaza reflow ca tranzitia sa porneasca
    entry.panel.style.height = '0px';
    entry.panel.dataset.open = 'false';
    entry.button.setAttribute('aria-expanded', 'false');
}

function expand(entry: Entry) {
    entry.panel.style.height = '0px';
    void entry.panel.offsetHeight; // fara el prima deschidere ar sari direct la final

    entry.panel.dataset.open = 'true';
    entry.button.setAttribute('aria-expanded', 'true');
    entry.panel.style.height = entry.panel.scrollHeight + 'px';
    releaseHeightAfter(entry);
}

/**
 * Dupa animatie lasam inaltimea libera, ca redimensionarea ferestrei sau
 * incarcarea pozelor din grila sa nu ramana taiate. Timerul e rezerva pentru
 * cazul in care transitionend nu se declanseaza (reduced-motion, tab in fundal).
 */
function releaseHeightAfter(entry: Entry) {
    const release = () => {
        if (entry.panel.dataset.open === 'true') entry.panel.style.height = 'auto';
    };

    const onDone = (e: TransitionEvent) => {
        if (e.target !== entry.panel || e.propertyName !== 'height') return;
        entry.panel.removeEventListener('transitionend', onDone);
        window.clearTimeout(expandTimer);
        release();
    };

    entry.panel.addEventListener('transitionend', onDone);
    window.clearTimeout(expandTimer);
    expandTimer = window.setTimeout(release, 700);
}

/** Trece panoul deschis de la inaltimea curenta la cea noua, animat. */
function resizeOpenPanel(entry: Entry) {
    const from = entry.panel.getBoundingClientRect().height;
    entry.panel.style.height = from + 'px';
    void entry.panel.offsetHeight;
    entry.panel.style.height = entry.panel.scrollHeight + 'px';
    releaseHeightAfter(entry);
}

function setView(mode: ViewMode) {
    if (viewMode === mode) return;

    if (openEntry) unmountView(openEntry);
    viewMode = mode;

    entries.forEach(entry => {
        entry.inner.dataset.view = mode;
        entry.hint.textContent = HINT[mode];
        paintToggle(entry);
    });

    if (openEntry) {
        mountView(openEntry);
        resizeOpenPanel(openEntry);
    }
}

function open(entry: Entry) {
    if (openEntry === entry) return;

    if (openEntry) {
        unmountView(openEntry);
        collapse(openEntry);
        openEntry = null;
    }

    mountView(entry);
    expand(entry);
    openEntry = entry;
}

function close(entry: Entry) {
    collapse(entry);
    openEntry = null;

    // detasam abia dupa ce panoul s-a strans, altfel panza dispare brusc
    // in mijlocul animatiei
    window.clearTimeout(collapseTimer);
    collapseTimer = window.setTimeout(() => {
        if (!openEntry) unmountView(entry);
    }, 500);
}

function toggle(entry: Entry) {
    if (openEntry === entry) close(entry);
    else open(entry);
}

function teardown() {
    window.clearTimeout(collapseTimer);
    window.clearTimeout(expandTimer);
    lazyObserver?.disconnect();
    lazyObserver = null;
    wheel?.destroy();
    wheel = null;
    openEntry = null;
    entries.length = 0;
}

async function initGallery() {
    const root = document.getElementById('gallery-root');
    if (!root) return;

    // avoid double-init on astro:page-load
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    viewMode = DEFAULT_VIEW; // fiecare intrare in tab porneste in modul roata

    root.innerHTML = '<div class="gallery-loading">Se încarcă galeria...</div>';

    let folders: FolderData[];
    try {
        const res = await fetch('/api/gallery.json');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        folders = await res.json();
    } catch (err) {
        console.error('Failed to load folder list:', err);
        root.innerHTML = '<div class="gallery-loading">Eroare la încărcarea galeriei.</div>';
        return;
    }

    root.innerHTML = '';

    folders.forEach((folder, i) => {
        const entry = buildSection(folder, i);
        if (entry) entries.push(entry);
    });

    // primul folder (cel mai recent) e deschis din start
    if (entries.length) open(entries[0]);
}

document.addEventListener('astro:before-swap', teardown);

// fallback for non-Astro-routed first load
['astro:page-load', 'DOMContentLoaded'].forEach((ev) => {
    document.addEventListener(ev, initGallery);
});
</script>
