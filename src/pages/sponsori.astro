---
import BaseLayout from "../layouts/BaseLayout.astro"
import NavBar from "../components/NavBar.astro"
import Footer from "../components/footer.astro";
import SponsorCard from "../components/sponsor_card.astro"
import HexBackground from "../components/hexbackground.astro"

/*
 * Sponsorii stau in api/sponsors.json, nu mai sunt scrisi aici: pagina de
 * rezultate are nevoie de numarul lor si il numara din aceeasi sursa
 * (era scris de mana acolo si ramasese in urma cu cinci).
 * Ordinea sectiunilor si a cardurilor din fisier e ordinea de pe pagina.
 */
import sponsorSections from "./api/sponsors.json";

/*
 * Siglele partenerilor sunt normalizate la aceeasi suprafata optica precum
 * cele ale sponsorilor (vezi logo-metrics.ts), dar sectiunea are doar cateva
 * carduri si a fost ceruta putin mai plina. Le dam un plus de 15% doar lor.
 */
const PARTENER_LOGO_SCALE = 1.15;
---

<BaseLayout title="Sponsori"
    description="Sponsorii si partenerii care sustin echipa de robotica Zenith 19084. Alatura-te si tu proiectului.">
    <NavBar activeLink={4} />
    <HexBackground />

    <!-- Titlul paginii, doar pentru cititoarele de ecran si pentru Google:
         designul nu prevede un h1 vizibil aici, dar pagina trebuie sa aiba unul. -->
    <h1 class="sr-only">Sponsorii si partenerii echipei Zenith 19084</h1>

    <main id="main-content">

    <div class="sponsor-page">

        {sponsorSections.map((sectiune) => (
            <section class="sponsor-section">
                <div class="title-container">
                    <h2 class="title-underline">{sectiune.title}</h2>
                </div>
                <div class="cards-grid">
                    {sectiune.sponsors.map((sponsor) => (
                        <SponsorCard
                            name={sponsor.name}
                            logo={sponsor.logo}
                            website={sponsor.website}
                            tier={sectiune.tier}
                            scale_factor={sectiune.tier === "partener" ? PARTENER_LOGO_SCALE : 1}
                        />
                    ))}
                </div>
            </section>
        ))}

    </div>
    </main>


    <Footer />
</BaseLayout>

<style>
    .sponsor-page { padding: 2rem 1rem 4rem; }
    .sponsor-section { margin-bottom: 5rem; }
    .sponsor-section:last-child { margin-bottom: 2rem; }

    .cards-grid {
        display:         flex;
        flex-wrap:       wrap;
        justify-content: center;
        gap:             1.5rem;
    }

    @media (max-width: 400px) {
        .cards-grid {
            gap: 1rem;
        }
    }
</style>
