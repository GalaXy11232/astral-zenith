---
import MemberCard from "../components/membru_card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/footer.astro";
import Hexbackground from "../components/hexbackground.astro";

import MembersGrid from "../components/membri_grid.astro";

import teamMembers from "./api/members.json";
import volunteers from "./api/volunteers.json";
import mentors from "./api/mentors.json";
---


<BaseLayout title = "Echipa"
    description="Membrii, voluntarii si mentorii echipei de robotica Zenith 19084 de la Colegiul National „Grigore Moisil”.">
    <NavBar activeLink={3} />
    <Hexbackground />

    <!-- Titlul paginii, doar pentru cititoarele de ecran si pentru Google:
         designul nu prevede un h1 vizibil aici, dar pagina trebuie sa aiba unul. -->
    <h1 class="sr-only">Echipa Zenith 19084</h1>

    <main id="main-content">


    <div class="title-container">
        <h2 class="title-underline">Membrii echipei</h2>
    </div>
    <div style = "padding-bottom: 5rem;"></div>

    <MembersGrid>
        {teamMembers.map((member) => (
            <MemberCard 
                name={member.name} 
                department={member.department} 
                image={member.image} 
                tooltip = {member.tooltip}
            />
        ))}
    </MembersGrid>

    <div style = "padding-top: 5rem;"></div>
    <div style = "padding-top: 5rem;"></div>
     <div class="title-container">
        <h2 class="title-underline">Voluntarii echipei</h2>
    </div>
    <div style = "padding-bottom: 5rem;"></div>

    <MembersGrid>
        {volunteers.map((vol) => (
            <MemberCard 
                name={vol.name} 
                department={vol.department} 
                image={vol.image} 
                tooltip = {vol.tooltip}
            />
        ))}
    </MembersGrid>

    <div style = "padding-top: 5rem;"></div>
    <div style = "padding-top: 5rem;"></div>
     <div class="title-container">
        <h2 class="title-underline">Mentorii echipei</h2>
    </div>
    <div style = "padding-bottom: 5rem;"></div>
    
    <MembersGrid>
        {mentors.map((mentor) => (
            <MemberCard 
                name={mentor.name} 
                department={mentor.department} 
                image={mentor.image} 
                tooltip = {mentor.tooltip}
            />
        ))}
    </MembersGrid>
    
    <div style = "padding-bottom: 8rem;"></div>
    </main>


    <Footer />
</BaseLayout>
