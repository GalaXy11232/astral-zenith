---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/footer.astro";
import ActivityCard from "../components/activity_card.astro";
import HexBackground from "../components/hexbackground.astro"

import { getCollection, render } from "astro:content";
import { existsSync, readdirSync } from "node:fs";
import { join } from "node:path";

/*
 * Activitatile nu mai sunt scrise aici. Fiecare are folderul ei in
 * originals/activitati/<slug>/, cu articol.md si pozele evenimentului
 * (vezi src/content.config.ts). Pagina doar le citeste si le ordoneaza.
 *
 * Ordinea vine din campul `date`, descrescator. Inainte era ordinea in care
 * erau scrise cardurile in fisier, deci o activitate noua trebuia inserata
 * manual la locul potrivit intre 70 de blocuri.
 */
const activitati = (await getCollection("activitati"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dataInRomana = new Intl.DateTimeFormat("ro-RO", {
    day: "numeric", month: "long", year: "numeric",
});

const EXT_IMAGINE = /^cover\.(jpe?g|png|webp|avif|gif)$/i;

/*
 * Coperta se cauta in public/assets/activitati/<slug>/, adica in ce a produs
 * `npm run images`, nu in originals/. Daca s-ar citi din originals/, o poza
 * neprocesata inca ar da o cale care raspunde 404; asa, pana ruleaza
 * scriptul, cardul apare pur si simplu fara coperta.
 *
 * Rezerva e campul `thumbnail` din articol.md, pentru articolele care inca
 * arata spre o coperta veche din assets/coperta articole/.
 */
function coperta(slug: string, thumbnail?: string): string | null {
    const dir = join(process.cwd(), "public", "assets", "activitati", slug);
    if (existsSync(dir)) {
        const fisier = readdirSync(dir).find(f => EXT_IMAGINE.test(f));
        if (fisier) return `/assets/activitati/${encodeURI(slug)}/${encodeURI(fisier)}`;
    }
    if (thumbnail) return "/" + thumbnail.replace(/^\//, "");
    return null;
}

const carduri = await Promise.all(activitati.map(async (activitate) => {
    const { Content } = await render(activitate);
    return {
        slug:    activitate.id,
        data:    activitate.data,
        Content,
        coperta: coperta(activitate.id, activitate.data.thumbnail),
    };
}));
---

<BaseLayout title = "Activitatea echipei"
    description="Activitatea echipei Zenith 19084: ateliere, demonstratii, voluntariat si evenimente de promovare a roboticii.">
    <NavBar activeLink = {2} />
    <HexBackground />

    <!-- Titlul paginii, doar pentru cititoarele de ecran si pentru Google:
         designul nu prevede un h1 vizibil aici, dar pagina trebuie sa aiba unul. -->
    <h1 class="sr-only">Activitatea echipei Zenith 19084</h1>

    <main id="main-content">

    <div class="title-container">
        <h2 class="title-underline">Activitatea Noastră</h2>
    </div>

    {carduri.map(({ slug, data, Content, coperta }) => (
        <ActivityCard
            title          = {data.title}
            date           = {data.dateLabel ?? dataInRomana.format(data.date)}
            thumbnail      = {coperta}
            thumbnailFocus = {data.focus}
            uid            = {slug}
        >
            <Content />
        </ActivityCard>
    ))}
    </main>


    <Footer />
</BaseLayout>

<style is:global>
    /* Cardurile cresc cu o tranzitie pe max-height (vezi activity_card.astro).
       Ancorarea de scroll a browserului isi alege un reper de sub punctul care
       creste si compenseaza mutand pozitia de scroll — masurat: -51px la un
       card din mijlocul paginii, adica exact saltul "in sus" pe care il simti
       cand apesi pe "Citeste mai mult".

       Regula trebuie sa stea pe scroller (radacina), nu pe card:
       overflow-anchor pe .card-content scoate doar cardul din lista de
       repere, iar reperul ales e oricum in afara lui, deci nu schimba nimic.

       is:global, dar numai pe pagina asta: ClientRouter schimba <head>-ul la
       fiecare navigare, deci regula nu ajunge pe restul site-ului, unde
       ancorarea e utila (imagini lazy care se incarca deasupra ecranului). */
    html { overflow-anchor: none; }
</style>
